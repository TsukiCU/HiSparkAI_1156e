{
  "name": "hispark-projectwizard-shadow",
  "displayName": "HiSpark Project Wizard Shadow",
  "description": "Lightweight project wizard for HiSpark AI chips (ws63 / 3322 / MCU / 1156E)",
  "version": "0.1.0",
  "publisher": "Huawei",
  "repository": { "url": "" },
  "engines": { "vscode": "^1.62.0" },
  "categories": ["Programming Languages", "Other"],
  "activationEvents": ["*"],
  "main": "./dist/extension",
  "contributes": {
    "commands": [
      {
        "command": "showProjectWizard",
        "title":   "New Project (Shadow)"
      },
      {
        "command": "showProjectImport",
        "title":   "Import Project (Shadow)"
      },
      { 
        "command": "openProject",
        "title":   "Open Project (Shadow)"
      },
      {
        "command": "deleteProject",
        "title":   "Delete Project from List (Shadow)"
      }
    ]
  },
  "scripts": {
    "build-frontend-dark":  "cross-env theme=dark  webpack --config ./scripts/webpack.front.config.js --mode production",
    "build-frontend-light": "cross-env theme=light webpack --config ./scripts/webpack.front.config.js --mode production",
    "build-backend":        "webpack --config ./scripts/webpack.pro.config.js",
    "build":                "npm run build-frontend-dark && npm run build-frontend-light && npm run build-backend",
    "watch":                "cross-env theme=dark webpack --config ./scripts/webpack.front.config.js --watch",
    "vscode:package":       "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce":                   "2.21.1",
    "@babel/core":                    "7.22.9",
    "@babel/plugin-transform-runtime":"7.22.9",
    "@babel/preset-env":              "7.22.9",
    "@babel/preset-react":            "7.16.7",
    "@babel/preset-typescript":       "7.22.5",
    "@babel/runtime":                 "7.22.6",
    "@types/node":                    "12.20.55",
    "@types/react":                   "18.2.56",
    "@types/react-dom":               "18.3.1",
    "@types/vscode":                  "1.62.0",
    "@typescript-eslint/eslint-plugin":"5.62.0",
    "@typescript-eslint/parser":      "5.62.0",
    "babel-loader":                   "8.3.0",
    "babel-plugin-import":            "1.13.6",
    "cross-env":                      "7.0.3",
    "css-loader":                     "6.8.1",
    "file-loader":                    "6.2.0",
    "html-webpack-plugin":            "5.5.3",
    "less":                           "4.1.3",
    "less-loader":                    "11.1.3",
    "mini-css-extract-plugin":        "2.7.6",
    "style-loader":                   "3.3.3",
    "svg-inline-loader":              "0.8.2",
    "ts-loader":                      "9.4.2",
    "typescript":                     "4.9.5",
    "webpack":                        "5.88.2",
    "webpack-cli":                    "4.10.0"
  },
  "overrides": {
    "cheerio": "1.0.0-rc.12"
  },
  "dependencies": {
    "antd":           "4.24.16",
    "i18next":        "23.12.2",
    "ini":            "5.0.0",
    "react":          "18.3.1",
    "react-dom":      "18.1.0",
    "react-i18next":  "13.5.0",
    "react-redux":    "8.1.3",
    "redux":          "5.0.1",
    "redux-saga":     "1.3.0"
  }
}
