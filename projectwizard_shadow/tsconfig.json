{
  "compilerOptions": {
    "module":                  "commonjs",
    "target":                  "es2017",
    "outDir":                  "./dist/",
    "lib":                     ["es6", "dom"],
    "sourceMap":               true,
    "rootDir":                 "src",
    "strict":                  true,
    "jsx":                     "react",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule":       true,
    "esModuleInterop":         true
  },
  "exclude": ["node_modules", "dist"]
}
