{
  "name": "hisparkprojectwizard",
  "displayName": "HiSpark Project Wizard",
  "description": "",
  "version": "0.0.4",
  "publisher": "Huawei",
  "repository": {
    "url": ""
  },
  "husky": {
    "hooks": {
      "pre-commit": "yarn format; yarn lint"
    }
  },
  "engines": {
    "vscode": "^1.62.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Device",
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "checkstart": [
    "Huawei-hisparkprojectwizard-newProject",
    "Huawei-hisparkprojectwizard-openProject",
    "Huawei-hisparkprojectwizard-projectSetting"
  ],
  "keywords": [
    "c",
    "c++",
    "microcontroller"
  ],
  "main": "./dist/extension",
  "icon": "resources/deveco-logo.png",
  "contributes": {
    "toolbarEntries": [
      {
        "id": "newProject",
        "icon": "resources/icons/newProject.svg",
        "name": "newProjectName",
        "group": "0_project_manage",
        "order": 1
      },
      {
        "id": "openProject",
        "icon": "resources/icons/openProject.svg",
        "name": "openProjectName",
        "group": "0_project_manage",
        "order": 2
      },
      {
        "id": "projectSetting",
        "icon": "resources/icons/projectSetting-custom.svg",
        "name": "projectSettingName",
        "group": "0_project_manage",
        "order": 3
      }
    ],
    "commands": [
      {
        "command": "showProjectWizard",
        "title": "show project wizard"
      },
      {
        "command": "showTargetManage",
        "title": "show Target Manage"
      },
      {
        "command": "showProjectSetting",
        "title": "show project setting"
      },
      {
        "command": "independentCompileConfig",
        "category": "Explorer",
        "title": "%independentCompileSetting%"
      },
      {
        "command": "toolsPath",
        "title": "tools path"
      },
      {
        "command": "showProjectImport",
        "title": "show project import wizard"
      },
      {
        "command": "openSingalProject",
        "title": "open single project"
      },
      {
        "command": "deleteProject",
        "title": "delete project"
      },
      {
        "command": "openProjectByPath",
        "title": "open a project by path"
      },
      {
        "command": "recreateHiproj",
        "title": "regenerate the default hiproj file"
      },
      {
        "command": "creDebugInitFile",
        "title": "create debug init file"
      },
      {
        "command": "creLaunchJsonFile",
        "title": "create launch.json file"
      },
      {
        "command": "canRecreateHiproj",
        "title": "check whether the hiproj file can be recreated"
      },
      {
        "command": "projectWizardExtensionPath",
        "title": "path of the project wizard"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "independentCompileConfig",
          "group": "8_operation@7",
          "when": "independenceVisable && resourceExtname == .c || explorerResourceIsFolder && !explorerResourceIsRoot && independenceVisable"
        }
      ]
    }
  },
  "scripts": {
    "build-dev": "webpack --config ./scripts/webpack.dev.config.js",
    "build-pro": "webpack --config ./scripts/webpack.pro.config.js",
    "build-frontend-dark": "cross-env theme=dark webpack --config ./scripts/webpack.front.config.js --mode production",
    "build-frontend-light": "cross-env theme=light webpack --config ./scripts/webpack.front.config.js --mode production",
    "copy-pythonUtils": "cp -rf ../commonplugin/common/pythonUtils.ts ./src",
    "copy-getArmGcc": "cp -rf ../commonplugin/common/getArmGcc.bat ./resources",
    "pre-launch": "npm run copy-pythonUtils && npm run copy-getArmGcc && yarn build-frontend-light && yarn build-frontend-dark && yarn build-pro",
    "watch": "cross-env theme=dark webpack --config ./scripts/webpack.front.config.js ./scripts/webpack.dev.config.js --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint --ext .ts src",
    "format": "prettier --write \"src/**/*.ts*\"&&eslint --ext .ts src --fix",
    "vscode:package": "node ./scripts/addVersionFull.js && vsce package",
    "test": "jest",
    "test-c": "jest --coverage"
  },
  "devDependencies": {
    "@babel/core": "7.22.9",
    "@babel/plugin-transform-runtime": "7.22.9",
    "@babel/preset-env": "7.22.9",
    "@babel/preset-react": "7.16.7",
    "@babel/preset-typescript": "7.22.5",
    "@babel/runtime": "7.22.6",
    "@types/cross-spawn": "6.0.2",
    "@types/glob": "7.2.0",
    "@types/ini": "1.3.31",
    "@types/node": "12.20.55",
    "@types/react": "17.0.30",
    "@types/react-dom": "17.0.11",
    "@types/vscode": "1.62.0",
    "@types/ws": "8.5.5",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "minimatch": "9.0.5",
    "babel-loader": "8.3.0",
    "babel-plugin-import": "1.13.6",
    "cross-env": "7.0.3",
    "css-loader": "6.8.1",
    "eslint": "8.45.0",
    "eslint-config-google": "0.14.0",
    "eslint-config-prettier": "8.8.0",
    "eslint-plugin-prettier": "4.2.1",
    "glob": "7.1.6",
    "html-webpack-plugin": "5.5.3",
    "husky": "7.0.4",
    "jest": "27.5.1",
    "less": "4.1.3",
    "less-loader": "11.1.3",
    "mini-css-extract-plugin": "2.7.6",
    "mocha": "8.4.0",
    "prettier": "2.8.8",
    "react-hot-loader": "4.13.1",
    "style-loader": "3.3.3",
    "ts-loader": "9.4.2",
    "typescript": "4.9.5",
    "webpack": "5.88.2",
    "webpack-cli": "4.10.0",
    "webpack-dev-server": "4.15.1",
    "ms": "2.1.3",
    "i18next": "23.12.2",
    "react-dom": "18.1.0"
  },
  "dependencies": {
    "antd": "4.24.16",
    "compressing": "2.1.0",
    "ini": "5.0.0",
    "log4js": "6.9.1",
    "react": "18.3.1",
    "react-i18next": "13.5.0",
    "react-redux": "8.1.3",
    "redux": "5.0.1",
    "redux-saga": "1.3.0",
    "serialport": "13.0.0"
  }
}