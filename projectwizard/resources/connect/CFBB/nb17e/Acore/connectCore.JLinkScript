void InitTarget(void) {
  int v;

  Report("J-Link script: Connect to Core APPS");
  //CPU=RISC-V;
  //
  // Manually configure which APs are present on the CoreSight device
  //
  CORESIGHT_AddAP(0, CORESIGHT_AHB_AP);  // AHB-AP of AHB BUS
  CORESIGHT_AddAP(1, CORESIGHT_AHB_AP);  // AHB-AP of second Cortex-M0	APPS
  CORESIGHT_AddAP(2, CORESIGHT_AHB_AP);  // AHB-AP of second Cortex-M0	PROT

  CORESIGHT_IndexAHBAPToUse  = 1;
}