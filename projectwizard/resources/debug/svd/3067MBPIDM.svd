              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>wdi</name>
              <description>看门狗中断（Watchdog Interrupt）。
0：未发生消息RAM看门狗事件；
1：因READY信号缺失而发生消息RAM看门狗事件。</description>
            </field>
            <field>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>bo</name>
              <description>Bus_Off状态（Bus_Off Status）。
0：Bus_Off状态未改变；
1：Bus_Off状态已改变。</description>
            </field>
            <field>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>ew</name>
              <description>警告状态（Warning Status）。
0：错误警告（Error_Warning）状态未改变；
1：错误警告（Error_Warning）状态已改变。</description>
            </field>
            <field>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>ep</name>
              <description>错误被动（Error Passive）。
0：错误被动（Error_Passive）状态未改变；
1：错误被动（Error_Passive）状态已改变。</description>
            </field>
            <field>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>elo</name>
              <description>错误记录溢出（Error Logging Overflow）。
0：CAN错误记录计数器未溢出；
1：CAN错误记录计数器已溢出。</description>
