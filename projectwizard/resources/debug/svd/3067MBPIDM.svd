              <access>read-only</access>
              <name>trp23</name>
              <description>发送缓冲区23的发送请求挂起标志。</description>
            </field>
            <field>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>trp22</name>
              <description>发送缓冲区22的发送请求挂起标志。</description>
