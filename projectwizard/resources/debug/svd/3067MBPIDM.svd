            </field>
          </fields>
        </register>
        <register>
          <name>FMC_OP_CFG</name>
          <addressOffset>0x0030</addressOffset>
          <description>FMC_OP_CFG为操作配置寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>14</bitOffset>
              <bitWidth>18</bitWidth>
