            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>rf0n</name>
              <description>接收FIFO0新消息（Rx FIFO 0 New Message）。
0：没有新消息写入接收FIFO0；
1：有新消息写入接收FIFO0。</description>
            </field>
