              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>23</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>scl_low_timeout</name>
              <description>SCL低电平超时配置。单位为I2C工作时钟周期。超时后，产生SCL低电平超时原始中断scl_low_timeout_raw。
0x000000：0个I2C工作时钟周期；
0x000001：1个I2C工作时钟周期；
…
0x7FFFFF：8388607个I2C工作时钟周期。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>I2C_BUS_FREE</name>
          <addressOffset>0x0108</addressOffset>
          <description>I2C_BUS_FREE为I2C总线空闲阈值寄存器。</description>
          <size>32</size>
          <resetValue>0x0000FFFF</resetValue>
          <fields>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>bus_free_time</name>
              <description>总线空闲阈值。单位为I2C工作时钟周期。控制器检测到STOP条件后，SCL和SDA同时为高电平并持续到达阈值时间，控制器认为总线空闲。
0x0000：0个I2C工作时钟周期；
0x0001：1个I2C工作时钟周期；
…
0xFFFF：65535个I2C工作时钟周期。
注意：控制器Master功能只有在总线空闲时才能发送命令代号为MST_S的时序命令。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>I2C_FILTER</name>
          <addressOffset>0x010C</addressOffset>
          <description>I2C_FILTER为I2C SDA和SCL滤波配置寄存器。</description>
          <size>32</size>
