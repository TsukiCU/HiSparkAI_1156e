            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>14</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>op_data_num</name>
              <description>一次操作所需要处理的数据长度。在有数据传输的操作时需要配置，对于DMA操作或AHB总线直接访问时不需要配置。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>FMC_OP</name>
          <addressOffset>0x003C</addressOffset>
          <description>FMC_OP为操作寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>9</bitOffset>
              <bitWidth>23</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>dummy_en</name>
              <description>地址操作后有传输dummy Byte操作使能。
0：禁止；
1：使能。</description>
            </field>
            <field>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
