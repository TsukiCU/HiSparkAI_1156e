              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>rg_gpt_en</name>
              <description>GPT使能控制。
0：GPT通道关闭；
1：GPT通道使能。</description>
