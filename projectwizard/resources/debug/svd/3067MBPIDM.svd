      </addressBlock>
      <registers>
        <register>
          <name>MBX_SOURCE0</name>
          <addressOffset>0x000</addressOffset>
          <description>MBX_SOURCE0为源处理器配置寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>3</bitOffset>
              <bitWidth>29</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
