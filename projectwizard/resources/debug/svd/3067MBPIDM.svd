          <fields>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>28</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>spike_filter_time</name>
              <description>SDA和SCL毛刺过滤配置。
0x0：不过滤毛刺；
0x1：过滤1个I2C工作时钟周期的毛刺；
0x2：过滤2个I2C工作时钟周期的毛刺；
…
0xF：过滤15个I2C工作时钟周期的毛刺。</description>
            </field>
          </fields>
        </register>
      </registers>
