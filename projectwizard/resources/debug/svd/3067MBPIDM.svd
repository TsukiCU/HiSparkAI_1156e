              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>rf1w</name>
              <description>接收FIFO1到达水位线（Rx FIFO 1 Watermark Reached）。
0：接收FIFO1的填充级别低于水位线；
1：接收FIFO1的填充级别达到水位线。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>rf1n</name>
              <description>接收FIFO1新消息（Rx FIFO 1 New Message）。
0：没有新消息写入接收FIFO1；
1：有新消息写入接收FIFO1。</description>
            </field>
            <field>
              <bitOffset>3</bitOffset>
