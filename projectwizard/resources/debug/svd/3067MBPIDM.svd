            </field>
            <field>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>dma_err_int_en</name>
              <description>DMA传输总线出现错误中断使能。
0：禁止；
1：使能。</description>
            </field>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>op_fail_int_en</name>
              <description>编程操作失败中断使能。
0：禁止；
1：使能。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>op_done_int_en</name>
              <description>FMC本次操作结束中断。
0：禁止；
1：使能。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>FMC_INT_CLR</name>
