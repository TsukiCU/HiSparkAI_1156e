        <register>
          <name>SC_LOCKEN</name>
          <addressOffset>0x0044</addressOffset>
          <description>SC_LOCKEN为关键寄存器的写保护控制寄存器。 仅当word写操作数的bit[31:16]位域为0xEA51时，才能对此寄存器进行写操作。
</description>
          <size>32</size>
          <resetValue>0x00000003</resetValue>
          <fields>
