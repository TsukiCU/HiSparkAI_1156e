        <register>
          <name>RXF0C</name>
          <addressOffset>0x00A0</addressOffset>
          <description>RXF0C为MCAN接收FIFO0配置寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>f0om</name>
              <description>接收FIFO0工作模式。
FIFO0可工作在阻塞模式（Blocking mode）或覆盖模式（Overwrite mode）。
0：接收FIFO0为阻塞模式；
1：接收FIFO0为覆盖模式。</description>
            </field>
            <field>
              <bitOffset>24</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>f0wm</name>
              <description>接收FIFO0水位线。
0x00：禁止接收FIFO0水位线中断；
0x01~0x40：接收FIFO0水位线中断（IR[rf0w]）的级别；
＞0x40：禁止接收FIFO0水位线中断。</description>
            </field>
            <field>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>f0s</name>
              <description>接收FIFO0大小。
0x00：无接收FIFO0；
0x01~0x40：接收FIFO0元素数量；
＞0x40：大于64的设定值被解析为64。
接收FIFO0元素的索引为0到F0S减1。</description>
            </field>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>14</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>f0sa</name>
              <description>接收FIFO0起始地址。
消息RAM中接收FIFO0的起始地址（32位字地址）。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>RXF0S</name>
          <addressOffset>0x00A4</addressOffset>
          <description>RXF0S为MCAN接收FIFO0状态寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>26</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>rf0ml</name>
              <description>接收FIFO0消息丢失。
该位是中断标志IR[rf0l]的副本。当IR[rf0l]被复位时，该位也被复位。
0：接收FIFO0无消息丢失；
1：接收FIFO0有消息丢失；对空间大小为0的接收FIFO0进行写操作时，该位也会置位。
注意：当RXF0C[f0om]=1时，覆盖最早的消息，不会置位该标志位。</description>
            </field>
            <field>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>f0f</name>
              <description>接收FIFO0满。
0：接收FIFO0未满；
1：接收FIFO0已满。</description>
            </field>
            <field>
              <bitOffset>22</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-only</access>
              <name>f0pi</name>
              <description>接收FIFO0放入索引。
接收FIFO0写入索引指针，范围0~63。</description>
            </field>
            <field>
              <bitOffset>14</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-only</access>
              <name>f0gi</name>
              <description>接收FIFO0获取索引。
接收FIFO0读取索引指针，范围0~63。</description>
            </field>
            <field>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-only</access>
              <name>f0fl</name>
              <description>接收FIFO0填充级别。
接收FIFO0中存储的元素数量，范围0~64。</description>
            </field>
          </fields>
        </register>
