<?xml version="1.0" encoding="utf-8" standalone="no"?>
<device schemaVersion="1.1" xs:noNamespaceSchemaLocation="CMSIS-SVD_Schema_1_1.xsd" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance">
  <name>3067M</name>
  <version>1.0</version>
  <description>3067M registers</description>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <size>32</size>
  <resetValue>0x00000000</resetValue>
  <resetMask>0xFFFFFFFF</resetMask>
  <peripherals>
    <peripheral>
      <name>PMC</name>
      <description>PMC peripheral interface</description>
      <groupName>PMC</groupName>
      <baseAddress>0x147E0000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0xf10</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>LOWPOWER_MODE</name>
          <addressOffset>0x200</addressOffset>
          <description>LOWPOWER_MODE为低功耗模式控制寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>5</bitOffset>
              <bitWidth>27</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>deepsleep_req</name>
              <description>系统进入deepsleep模式请求。
对此寄存器位域写1操作将触发MCU进入deepsleep模式流程。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>CNT32K_WAKE_CYC</name>
          <addressOffset>0x204</addressOffset>
          <description>CNT32K_WAKE_CYC为定时唤醒周期设置寄存器。</description>
          <size>32</size>
          <resetValue>0x0000FFFF</resetValue>
          <fields>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>cnt32k_wakeup_cycle</name>
              <description>定时唤醒周期数（计数时钟clk_losc）。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>WAKEUP_CTRL</name>
          <addressOffset>0x208</addressOffset>
          <description>WAKEUP_CTRL为deepsleep模式唤醒控制寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>25</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>cnt32k_wakeup_en</name>
              <description>定时唤醒使能。
0：不使能；
1：使能。</description>
            </field>
            <field>
              <bitOffset>19</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>iwdg_wakeup_en</name>
              <description>IWDG唤醒使能。
0：不使能；
1：使能。</description>
            </field>
            <field>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>wakeup5_en</name>
              <description>WAKEUP5使能。
0：不使能；
1：使能。</description>
            </field>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>wakeup4_en</name>
              <description>WAKEUP4使能。
0：不使能；
1：使能。</description>
            </field>
            <field>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>wakeup3_en</name>
              <description>WAKEUP3使能。
0：不使能；
1：使能。</description>
            </field>
            <field>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>wakeup2_en</name>
              <description>WAKEUP2使能。
0：不使能；
1：使能。</description>
            </field>
            <field>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>wakeup1_en</name>
              <description>WAKEUP1使能。
0：不使能；
1：使能。</description>
            </field>
            <field>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>wakeup0_en</name>
              <description>WAKEUP0使能。
0：不使能；
1：使能。</description>
            </field>
            <field>
              <bitOffset>10</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>wakeup5_act_mode</name>
              <description>WAKEUP5有效模式选择。
00：上升沿有效；
01：下降沿有效；
10：高电平有效；
11：低电平有效。</description>
            </field>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>wakeup4_act_mode</name>
              <description>WAKEUP4有效模式选择。
00：上升沿有效；
01：下降沿有效；
10：高电平有效；
11：低电平有效。</description>
            </field>
            <field>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>wakeup3_act_mode</name>
              <description>WAKEUP3有效模式选择。
00：上升沿有效；
01：下降沿有效；
10：高电平有效；
11：低电平有效。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>wakeup2_act_mode</name>
              <description>WAKEUP2有效模式选择。
00：上升沿有效；
01：下降沿有效；
10：高电平有效；
11：低电平有效。</description>
            </field>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>wakeup1_act_mode</name>
              <description>WAKEUP1有效模式选择。
00：上升沿有效；
01：下降沿有效；
10：高电平有效；
11：低电平有效。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>wakeup0_act_mode</name>
              <description>WAKEUP0有效模式选择。
00：上升沿有效；
01：下降沿有效；
10：高电平有效；
11：低电平有效。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>LOWPOWER_STATUS</name>
          <addressOffset>0x20C</addressOffset>
          <description>LOWPOWER_STATUS为低功耗状态查询寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>18</bitOffset>
              <bitWidth>14</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>wakeup5_status</name>
              <description>WAKEUP5唤醒源状态。
0：唤醒源低电平；
1：唤醒源高电平。</description>
            </field>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>wakeup4_status</name>
              <description>WAKEUP4唤醒源状态。
0：唤醒源低电平；
1：唤醒源高电平。</description>
            </field>
            <field>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>wakeup3_status</name>
              <description>WAKEUP3唤醒源状态。
0：唤醒源低电平；
1：唤醒源高电平。</description>
            </field>
            <field>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>wakeup2_status</name>
              <description>WAKEUP2唤醒源状态。
0：唤醒源低电平；
1：唤醒源高电平。</description>
            </field>
            <field>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>wakeup1_status</name>
              <description>WAKEUP1唤醒源状态。
0：唤醒源低电平；
1：唤醒源高电平。</description>
            </field>
            <field>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>wakeup0_status</name>
              <description>WAKEUP0唤醒源状态。
0：唤醒源低电平；
1：唤醒源高电平。</description>
            </field>
            <field>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>starup_from_deepsleep</name>
              <description>从deepsleep状态启动标识。
0：未从deepsleep模式启动；
1：从deepsleep模式启动。</description>
            </field>
            <field>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>starup_from_shutdown</name>
              <description>MCU初次上电启动标识。
0：不是初次上电启动；
1：是初次上电启动。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>9</bitWidth>
              <access>read-only</access>
              <name>wakeup_src_lock</name>
              <description>启动唤醒源查询。
bit[8]：IWDG唤醒；
bit[7]：RESETN管脚唤醒；
bit[6]：WAKEUP5唤醒；
bit[5]：WAKEUP4唤醒；
bit[4]：WAKEUP3唤醒；
bit[3]：WAKEUP2唤醒；
bit[2]：WAKEUP1唤醒；
bit[1]：WAKEUP0唤醒；
bit[0]：cnt32k定时唤醒。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>PVD_CTRL</name>
          <addressOffset>0xA00</addressOffset>
          <description>PVD_CTRL为PVD控制寄存器。</description>
