            </field>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>pvd_fall_lv</name>
              <description>PVD下降沿阈值。
000：2.08V；
001：2.18V；
010：2.28V；
011：2.38V；
100：2.48V；
101：2.58V；
110：2.68V；
111：2.78V。</description>
            </field>
            <field>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>pvd_rise_lv</name>
              <description>PVD上升沿阈值。
000：2.18V；
001：2.28V；
010：2.38V；
011：2.48V；
100：2.58V；
101：2.68V；
110：2.78V；
111：2.88V。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>pvd_en</name>
              <description>PVD使能。
0：不使能；
1：使能。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>PMU_VSENSOR</name>
          <addressOffset>0xA10</addressOffset>
          <description>PMU_VSENSOR为CORE域电压监控寄存器。</description>
          <size>32</size>
          <resetValue>0x00005509</resetValue>
          <fields>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>12</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>pmu_core_rst_req_enable</name>
              <description>CORE PVD输出的rst_req是否有效使能，多数判决，0x0时关闭此功能，其他值开启。
默认不使能。</description>
            </field>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>pmu_core_pvd_enable</name>
              <description>PMU CORE域电压监控使能，多数判决，0x0时关闭此功能，其他值开启。
默认不使能。</description>
            </field>
            <field>
              <bitOffset>5</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>pmu_core_vseneor_thld</name>
              <description>bit[4:0] PMU CORE域电压监控阈值配置，默认0.896V，配置值为0x9，step为16mV。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>RST_INOUT_ENABLE</name>
          <addressOffset>0xA14</addressOffset>
          <description>RST_INOUT_ENABLE为RST信号输入输出控制使能寄存器。</description>
          <size>32</size>
          <resetValue>0x00000002</resetValue>
