            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>dummy_num</name>
              <description>对于dummy_en的操作Byte个数。
（1Byte=4线2时钟周期=2线4时钟周期=1线8时钟周期）</description>
            </field>
          </fields>
