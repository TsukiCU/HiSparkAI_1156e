    <peripheral>
      <name>SYSCTRL0</name>
      <description>SYSCTRL0 peripheral interface</description>
      <groupName>SYSCTRL0</groupName>
      <baseAddress>0x10100000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x8000</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>SC_STATUS</name>
          <addressOffset>0x0000</addressOffset>
          <description>SC_STATUS为系统状态寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>31</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access/>
              <name>bootrom_finish</name>
              <description>bootrom退出时，需将该寄存器改写为1。
注意：与OTP的bootrom_debug_enable、bootrom_hide_disable配合完成相关安全保护。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>SC_SYS_RES</name>
          <addressOffset>0x0004</addressOffset>
          <description>SC_SYS_RES为系统软件复位寄存器。 该寄存器受写保护控制，由寄存器SC_LOCKEN[sc_cfg_lock]决定。只有写使能时，对此寄存器的写操作才有效。
</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>31</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access/>
              <name>softresreq</name>
              <description>对此寄存器位域的任意写操作都会导致系统软复位。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>SC_RST_CNT0</name>
          <addressOffset>0x0008</addressOffset>
          <description>SC_RST_CNT0为复位次数统计寄存器0。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
              <name>ext_rst_cnt</name>
              <description>RESETN管脚复位次数统计。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
              <name>soft_rst_cnt</name>
              <description>软复位次数统计。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>SC_RST_CNT1</name>
          <addressOffset>0x000C</addressOffset>
          <description>SC_RST_CNT1为复位次数统计寄存器1。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
              <name>iwdg_rst_cnt</name>
              <description>IWDG复位次数统计。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
              <name>wdg0_rst_cnt</name>
              <description>WDG0复位次数统计。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>SC_RST_CNT2</name>
          <addressOffset>0x0010</addressOffset>
          <description>SC_RST_CNT2为复位次数统计寄存器2。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
              <name>wdg2_rst_cnt</name>
              <description>WDG2复位次数统计。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
              <name>wdg1_rst_cnt</name>
              <description>WDG1复位次数统计。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>SC_SYS_STAT</name>
          <addressOffset>0x0018</addressOffset>
          <description>SC_SYS_STAT为系统启动模式寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>5</bitOffset>
              <bitWidth>27</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>update_mode</name>
              <description>系统升级标识，芯片上电时锁存。
0：不升级，直接启动模式；
1：升级模式。
注意：当处于升级模式时，芯片JTAG相关管脚强制为JTAG功能，无法软件切换为其他复用功能。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>update_mode_clear</name>
              <description>系统升级标识清除寄存器，芯片上电完成后生效。
0：不清除；
1：清除。</description>
            </field>
          </fields>
        </register>
