        <register>
          <name>OC_EVT_FLAG</name>
          <addressOffset>0x0320</addressOffset>
          <description>OC_EVT_FLAG为事件中断标志和清除寄存器。根据INT_EVT_EN bit[15]~bit[0]配置的中断使能，相应的OC_EVT_FLAG bit[15:0]有效会触发事件中断APTxEVTINT，相应的OC_EVT_FLAG bit[15:0]。对OC_EVT_FLAG bit[31:16]写1会清除相应的事件中断标志。支持写保护。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
              <name>rg_ocb_clr_max_free</name>
              <description>B路FREE保护超时事件中断标志位的清除位，写1清零。
0：写0无效；
1：写1有效，清除ro_oc_flag_ocb_max_free。</description>
            </field>
            <field>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
              <name>rg_oca_clr_max_free</name>
