        <register>
          <name>RXESC</name>
          <addressOffset>0x00BC</addressOffset>
          <description>RXESC为MCAN接收缓冲区和FIFO元素大小配置寄存器。配置接收缓冲区和接收FIFO元素的数据字节数。大于8Byte的数据场（Data field）仅适用于CAN-FD模式。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>11</bitOffset>
              <bitWidth>21</bitWidth>
