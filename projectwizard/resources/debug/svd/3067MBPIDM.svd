    <peripheral>
      <name>FMC</name>
      <description>FMC peripheral interface</description>
      <groupName>FMC</groupName>
      <baseAddress>0x1C0E0000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0xb0</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>FMC_CFG</name>
          <addressOffset>0x0000</addressOffset>
          <description>FMC_CFG为器件配置寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>11</bitOffset>
              <bitWidth>21</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>spi_nor_addr_mode</name>
              <description>SPI地址模式。
0：3Bytes address mode（default）；
1：4Bytes address mode。
复位值由管脚FMC_PAGE_SIZE决定。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>9</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>op_mode</name>
              <description>FMC操作模式选择。
0：boot模式；
1：normal模式。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>GLOBAL_CFG</name>
          <addressOffset>0x0004</addressOffset>
          <description>GLOBAL_CFG为全局配置寄存器。</description>
          <size>32</size>
          <resetValue>0x00000040</resetValue>
          <fields>
            <field>
              <bitOffset>7</bitOffset>
              <bitWidth>25</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>wp_en</name>
              <description>写保护使能（WP管脚）。当使能时，芯片对WP管脚输出为0。
0：不使能；
1：使能。</description>
            </field>
            <field>
              <bitOffset>3</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>rd_delay</name>
              <description>SPI读出数据延迟周期个数（SDR模式下）。
000：读数据延迟0个时钟周期（default）；
001：读数据延迟0.5个器件工作时钟周期；
010：读数据延迟1个器件工作时钟周期；
011：读数据延迟1.5个器件工作时钟周期；
100：读数据延迟2个器件工作时钟周期；
101：读数据延迟2.5个器件工作时钟周期；
110：读数据延迟3个器件工作时钟周期；
111：读数据延迟3.5个器件工作时钟周期。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>TIMING_SPI_CFG</name>
          <addressOffset>0x0008</addressOffset>
          <description>TIMING_SPI_CFG为SPI Timing配置寄存器。</description>
          <size>32</size>
          <resetValue>0x0000006F</resetValue>
          <fields>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>tcss</name>
              <description>CS setup time。
000～111：n+1个接口时钟周期。n为0、1、2、……、7。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>tshsl</name>
              <description>设置片选的Deselect time，相当于两次Flash操作之间的时间间隔。
0000～1111：n+1个接口时钟周期。n为0、1、2、……、15。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>FMC_INT</name>
          <addressOffset>0x0018</addressOffset>
          <description>FMC_INT为中断状态寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>ahb_op_int</name>
              <description>FMC对Flash进行数据操作期间，cpu读写内部Buffer错误中断。
0：无中断；
1：有中断。</description>
            </field>
            <field>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>dma_err_int</name>
              <description>DMA传输总线出现错误中断。
0：无中断；
1：有中断。</description>
            </field>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>op_fail_int</name>
              <description>编程操作失败，上报中断。
0：无中断；
1：有中断。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>op_done_int</name>
              <description>FMC本次操作结束中断。
写operation寄存器后，该标志自动清零。
0：无中断；
1：有中断。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>FMC_INT_EN</name>
          <addressOffset>0x001C</addressOffset>
