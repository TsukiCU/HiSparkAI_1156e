              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>rbds</name>
              <description>接收缓冲区数据场大小。
000：8Byte；
001：12Byte；
010：16Byte；
011：20Byte；
100：24Byte；
