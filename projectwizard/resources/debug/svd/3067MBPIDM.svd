              <name>txfneim</name>
              <description>发送FIFO非空中断的屏蔽状态。
0：屏蔽该中断；
1：不屏蔽该中断。</description>
            </field>
            <field>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
