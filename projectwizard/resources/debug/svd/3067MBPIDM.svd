    <peripheral>
      <name>APT0</name>
      <description>APT0 peripheral interface</description>
      <groupName>APT</groupName>
      <baseAddress>0x14A00000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0xb10</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>VER_INFO</name>
          <addressOffset>0x0000</addressOffset>
          <description>VER_INFO为版本信息寄存器。</description>
          <size>32</size>
          <resetValue>0x00000020</resetValue>
          <fields>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
              <name>main_version</name>
              <description>主版本号。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
              <name>sub_version</name>
              <description>子版本号。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>PROT_KEY</name>
          <addressOffset>0x0004</addressOffset>
          <description>PROT_KEY为保护配置寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>write_protect_key</name>
              <description>写保护关键字。
0x55：软件可写支持写保护的寄存器；
其他：软件不可写支持写保护的寄存器，只可读。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>TC_MODE</name>
          <addressOffset>0x0010</addressOffset>
          <description>TC_MODE为计数模式寄存器。</description>
          <size>32</size>
          <resetValue>0x20000000</resetValue>
          <fields>
            <field>
              <bitOffset>30</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>28</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>rg_emu_stop</name>
              <description>CPU debug模式，APT停止的方式。注意，如果停止APT，那么在CPU debug模式下，整个APT都会停止工作，包括输出控制功能。
0X：不停止；
10：停止分频计数器（DIVCNT）和时基计数器（TCCNT）；
11：停止APT。</description>
            </field>
