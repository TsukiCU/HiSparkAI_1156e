              <name>ar27</name>
              <description>发送缓冲区27的添加请求。</description>
            </field>
            <field>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>ar26</name>
              <description>发送缓冲区26的添加请求。</description>
            </field>
            <field>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>ar25</name>
              <description>发送缓冲区25的添加请求。</description>
            </field>
            <field>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>ar24</name>
              <description>发送缓冲区24的添加请求。</description>
