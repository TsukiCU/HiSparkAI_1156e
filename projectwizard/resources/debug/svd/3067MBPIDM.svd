              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>tcf</name>
              <description>发送取消已完成（Transmission Cancellation Finished）。
0：发送取消未完成；
1：发送取消已完成。</description>
            </field>
            <field>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>tc</name>
