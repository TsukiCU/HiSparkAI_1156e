            </field>
            <field>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>boe</name>
              <description>Bus_Off状态中断（Bus_Off Status Interrupt Enable）。
0：禁止中断；
1：使能中断。</description>
            </field>
            <field>
              <bitOffset>24</bitOffset>
