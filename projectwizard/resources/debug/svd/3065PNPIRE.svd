        <register>
          <name>UART_DMACR</name>
          <addressOffset>0x048</addressOffset>
          <description>UART_DMACR为DMA控制寄存器，用于配置发送通道和接收通道的DMA使能。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>28</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>rxlastsreq_en</name>
              <description>UART RX DMA支持最后一笔数据的REQ使能。使能打开后，传输最后一笔数据时会发出LASTREQ给DMA控制器。可以自动对DMA进行硬件流控。
0：禁止；
1：使能。</description>
            </field>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>dmaonerr</name>
              <description>UART错误中断（UARTEINTR）出现时的接收通道DMA使能控制。
0：当UART错误中断（UARTEINTR）有效时，接收通道DMA的请求输出（UARTRXDMASREQ或UARRTXDMABREQ）有效；
1：当UART错误中断（UARTEINTR）有效时，接收通道DMA的请求输出（UARTRXDMASREQ或UARRTXDMABREQ）无效。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>txdmae</name>
              <description>发送通道的DMA使能控制。
0：禁止；
1：使能。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>rxdmae</name>
              <description>接收通道的DMA使能控制。
0：禁止；
1：使能。</description>
            </field>
          </fields>
        </register>
