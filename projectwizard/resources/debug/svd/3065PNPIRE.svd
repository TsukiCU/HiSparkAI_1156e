<?xml version="1.0" encoding="utf-8" standalone="no"?>
<device schemaVersion="1.1" xs:noNamespaceSchemaLocation="CMSIS-SVD_Schema_1_1.xsd" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance">
  <name>3065PNPIRE</name>
  <version>1.0</version>
  <description>3065PNPIRE registers</description>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <size>32</size>
  <resetValue>0x00000000</resetValue>
  <resetMask>0xFFFFFFFF</resetMask>
  <peripherals>
    <peripheral>
      <name>FLASH</name>
      <description>FLASH peripheral interface</description>
      <groupName>FLASH</groupName>
      <baseAddress>0x14710000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x608</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>EFLASH_CMD</name>
          <addressOffset>0x000</addressOffset>
          <description>EFLASH_CMD为命令寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>26</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>20</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>cmd_pgm_size</name>
              <description>Program Size寄存器，Unit:Word（32bit）。
0x0：2；
0x1：4；
0x2：8；
…
0x0F：60；
0x10：64；
其他：非法值。
cmd_addr + cmd_pgm_size寻址范围不能跨越Flash-Row（64Word），cmd_addr需要按64bit对齐。</description>
            </field>
            <field>
              <bitOffset>11</bitOffset>
              <bitWidth>9</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>cmd_code</name>
              <description>操作字寄存器。
010：MAIN Program；
011：INFO Program；
100：MAIN Erase；
101：INFO Erase；
110：Mass Erase（Only Main区，不含INFO区）；
其他：无操作。</description>
            </field>
            <field>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
              <name>exec_state</name>
              <description>Flash CMD执行状态debug寄存器。
00（IDLE）：无操作或操作已完成；
01（RUNNING）：有操作在执行；
10（FINISH）：操作完成，但完成标示未清除（中断模式才生效）；
11：保留。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>cmd_start</name>
              <description>Flash CMD操作启动寄存器。
写1启动Flash CMD操作；
写0无影响；
读1 Flash CMD操作未完成；
读0 Flash CMD操作完成或无操作。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>EFLASH_ADDR</name>
          <addressOffset>0x004</addressOffset>
          <description>EFLASH_ADDR为地址寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>24</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>cmd_addr</name>
              <description>Program或者Erase的起始地址寄存器，Unit:Byte（8bit）。
Main Region起始地址：0x00_0000；
Information Region起始地址：0x80_0000。
注意：控制器自动忽略低2bit地址。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>CMD_CFG_COMMON</name>
          <addressOffset>0x080</addressOffset>
          <description>CMD_CFG_COMMON为Flash CMD配置寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>30</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>int_mode</name>
              <description>Flash CMD操作方式控制寄存器。
0：轮询方式；
1：中断方式，此方式Flash CMD操作完成后需要配置int_clr_finish清除完成标识，方可进行下一次操作。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>INT_RAW_STATUS</name>
          <addressOffset>0x100</addressOffset>
          <description>INT_RAW_STATUS为中断原始状态寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>21</bitOffset>
              <bitWidth>11</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>int_raw_err_ecc_chk</name>
              <description>Main Region或Information Region 读数据ECC检验错误原始中断寄存器。
0：无错误，或者读数据ECC检错功能未使能；
1：发生ECC检查错误。</description>
            </field>
            <field>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>int_raw_err_ecc_corr</name>
              <description>Main Region或Information Region 读数据ECC纠正错误原始中断寄存器。
0：无错误，或者读数据ECC纠错功能未使能；
1：发生无法纠正的ECC错误。</description>
            </field>
            <field>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>int_raw_err_ahb</name>
              <description>AHB请求错误原始中断寄存器。
0：无错误；
1：AHB读请求地址超过Main Region或Information Region范围或发生了AHB写请求。</description>
            </field>
            <field>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>int_raw_err_erase</name>
              <description>擦除错误原始中断状态寄存器。
0：擦除操作Verify成功；
1：擦除操作Verify失败。</description>
            </field>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>int_raw_err_illegal</name>
              <description>非法Flash CMD操作错误原始中断寄存器。
0：无错误；
1：存在Flash CMD操作错误，具体错误，需要查询FLASH_STATUS寄存器。</description>
            </field>
            <field>
              <bitOffset>5</bitOffset>
              <bitWidth>11</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>int_raw_finish</name>
              <description>Flash CMD操作完成原始中断寄存器。
0：无操作或者操作未完成；
1：操作已完成。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>INT_STATUS</name>
          <addressOffset>0x104</addressOffset>
          <description>INT_STATUS为中断状态寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>21</bitOffset>
              <bitWidth>11</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>int_err_ecc_chk</name>
              <description>Main Region或Information Region读数据ECC检验错误中断状态寄存器。
0：无错误，或者读数据ECC检错功能未使能；
1：发生ECC检查错误。</description>
            </field>
            <field>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>int_err_ecc_corr</name>
              <description>Main Region或Information Region 读数据ECC纠正错误中断状态寄存器。
0：无错误，或者读数据ECC纠错功能未使能；
1：发生无法纠正的ECC错误。</description>
            </field>
            <field>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>int_err_ahb</name>
              <description>AHB请求错误中断状态寄存器。
0：无错误；
1：AHB读请求地址超过Main Region或Information Region范围或发生了AHB写请求。</description>
            </field>
            <field>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>int_err_erase</name>
              <description>擦除错误中断状态寄存器。
0：擦除操作Verify成功；
1：擦除操作Verify失败。</description>
            </field>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>int_err_illegal</name>
              <description>非法Flash CMD操作错误中断状态寄存器。
0：无错误；
1：存在Flash CMD操作错误，具体错误，需要查询FLASH_STATUS寄存器。</description>
            </field>
            <field>
              <bitOffset>5</bitOffset>
              <bitWidth>11</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>int_finish</name>
              <description>Flash CMD操作完成中断状态寄存器。
0：无操作或者操作未完成；
1：操作已完成。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>INT_ENABLE</name>
          <addressOffset>0x108</addressOffset>
          <description>INT_ENABLE为中断使能配置寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>21</bitOffset>
              <bitWidth>11</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>int_en_err_ecc_chk</name>
              <description>Main Region或Information Region读数据ECC检验错误中断使能寄存器。
0：不使能，上报原始中断，不上报中断状态，不上报CPU中断；
1：使能，上报原始中断，上报中断状态，上报CPU中断。</description>
            </field>
            <field>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>int_en_err_ecc_corr</name>
              <description>Main Region或Information Region读数据ECC纠正错误中断使能寄存器。
0：不使能，上报原始中断，不上报中断状态，不上报CPU中断；
1：使能，上报原始中断，上报中断状态，上报CPU中断。</description>
            </field>
            <field>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>int_en_err_ahb</name>
              <description>AHB请求错误中断使能寄存器。
0：不使能，上报原始中断，不上报中断状态，不上报CPU中断；
1：使能，上报原始中断，上报中断状态，上报CPU中断。</description>
            </field>
            <field>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>int_en_err_erase</name>
              <description>擦除错误中断使能寄存器。
0：不使能，上报原始中断，不上报中断状态，不上报CPU中断；
1：使能，上报原始中断，上报中断状态，上报CPU中断。</description>
            </field>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>int_en_err_illegal</name>
              <description>非法Flash CMD操作错误中断使能寄存器。
0：不使能，上报原始中断，不上报中断状态，不上报CPU中断；
1：使能，上报原始中断，上报中断状态，上报CPU中断。</description>
            </field>
            <field>
              <bitOffset>5</bitOffset>
              <bitWidth>11</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>int_en_finish</name>
              <description>Flash CMD操作完成中断使能寄存器。
0：不使能，上报原始中断，不上报中断状态，不上报CPU中断；
1：使能，上报原始中断，上报中断状态，上报CPU中断。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>INT_CLEAR</name>
          <addressOffset>0x10C</addressOffset>
          <description>INT_CLEAR为中断清除寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>21</bitOffset>
              <bitWidth>11</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
              <name>int_clr_err_ecc_chk</name>
              <description>Main Region或Information Region读数据ECC检验错误中断清除寄存器。
0：不清除；
1：清除原始中断与中断状态。</description>
            </field>
            <field>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
              <name>int_clr_err_ecc_corr</name>
              <description>Main Region或Information Region读数据ECC纠正错误中断清除寄存器。
0：不清除；
1：清除原始中断与中断状态。</description>
            </field>
            <field>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
              <name>int_clr_err_ahb</name>
              <description>AHB请求错误中断清除寄存器。
0：不清除；
1：清除原始中断与中断状态。</description>
            </field>
            <field>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
              <name>int_clr_err_erase</name>
              <description>擦除错误中断清除寄存器。
0：不清除；
1：清除原始中断与中断状态。</description>
            </field>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
              <name>int_clr_err_illegal</name>
              <description>非法Flash CMD操作错误中断清除寄存器。
0：不清除；
1：清除原始中断与中断状态。</description>
            </field>
            <field>
              <bitOffset>5</bitOffset>
              <bitWidth>11</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
              <name>int_clr_finish</name>
              <description>Flash CMD操作完成中断清除寄存器。
0：不清除；
1：清除原始中断与中断状态。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>PFEFETCH_CTRL</name>
          <addressOffset>0x120</addressOffset>
          <description>PFEFETCH_CTRL为预取控制寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>9</bitOffset>
              <bitWidth>23</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>prefetch_invalid_req</name>
              <description>Cache数据无效请求控制寄存器。
写0：无效；
写1：请求prefetch_invalid，逻辑完成invalid后自动清除该bit；
读0：最近一次invalid请求已完成；
读1：最近一次invalid请求未完成。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>prefetch_enable</name>
              <description>预取使能控制寄存器。
0：预取使能关闭；
1：每次AHB传输完成尾地址向前预取16Byte数据（以8Byte对齐）。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>CACHE_CTRL</name>
          <addressOffset>0x124</addressOffset>
          <description>CACHE_CTRL为Cache控制寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>13</bitOffset>
              <bitWidth>19</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>cache_policy_sel</name>
              <description>Cache策略选择控制寄存器。
0：Normal Cache；
1：Branch Cache。</description>
            </field>
            <field>
              <bitOffset>9</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>cache_invalid_req</name>
              <description>Cache数据无效请求控制寄存器。
写0：无效；
写1：请求Cache invalid，逻辑完成invalid后自动清除该bit；
读0：最近一次invalid请求已完成；
读1：最近一次invalid请求未完成。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>cache_enable</name>
              <description>Cache使能控制寄存器。
0：Cache使能关闭；
1：Cache使能打开，AHB传输数据将会查询Cache，Cache Hit则数据从Cache获取，Cache miss则数据从eFlash获取，并将此地址数据缓存进入Cache。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>FLASH_ECC_CTRL</name>
          <addressOffset>0x12C</addressOffset>
          <description>FLASH_ECC_CTRL为Flash ECC检错纠错使能控制寄存器。</description>
          <size>32</size>
          <resetValue>0x0000001C</resetValue>
          <fields>
            <field>
              <bitOffset>5</bitOffset>
              <bitWidth>27</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>flash_ecc_blank_filter_enable</name>
              <description>Flash未编程区域ECC屏蔽过滤使能控制（72bit全1判断为未编程区域）。
0：不使能此功能，所有Read访问数据都根据flash_ecc_correct_enable、flash_ecc_check_enable配置进行相应的ECC检查或者纠正；
1：使能此功能，检查Read访问数据内容，只有非全1（72bit）数据根据flash_ecc_correct_enable、flash_ecc_check_enable配置进行相应的ECC检查或者纠正。</description>
            </field>
            <field>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>flash_info_ecc_correct_enable</name>
              <description>Flash Information Region ECC纠错功能控制。
0：回读数据发生错误时，不进行ECC纠错；
1：回读数据发生1bit错误时，进行ECC纠错。</description>
            </field>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>flash_info_ecc_check_enable</name>
              <description>Flash Information Region 检错使能控制（Program 强制ECC打开）。
0：回读数据不进行ECC检查；
1：回读数据进行ECC检查。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>flash_main_ecc_correct_enable</name>
              <description>Flash Main Region ECC纠错功能控制。
0：回读数据发生错误时，不进行ECC纠错；
1：回读数据发生1bit错误时，进行ECC纠错。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>flash_main_ecc_check_enable</name>
