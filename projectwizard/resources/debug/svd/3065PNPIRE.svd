          <resetValue>0x0000001F</resetValue>
          <fields>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>rtcfg</name>
              <description>配置接收超时时长，单位是bit时长。
接收超时时长=配置值+1。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>UART_SPCFG</name>
          <addressOffset>0x058</addressOffset>
          <description>UART_SPCFG为过采样配置寄存器，用于配置过采样倍数。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>28</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
