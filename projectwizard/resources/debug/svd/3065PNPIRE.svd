              <description>保留。</description>
            </field>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>DATA1</name>
              <description>CAN帧数据Byte 1。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>DATA0</name>
              <description>CAN帧数据Byte 0。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>IF1_DATAA2</name>
          <addressOffset>0x0040</addressOffset>
          <description>IF1_DATAA2为IF1数据A2寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>DATA3</name>
              <description>CAN帧数据Byte 3。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>DATA2</name>
              <description>CAN帧数据Byte 2。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>IF1_DATAB1</name>
          <addressOffset>0x0044</addressOffset>
          <description>IF1_DATAB1为IF1数据B1寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>DATA5</name>
              <description>CAN帧数据Byte 5。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>DATA4</name>
              <description>CAN帧数据Byte 4。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>IF1_DATAB2</name>
          <addressOffset>0x0048</addressOffset>
          <description>IF1_DATAB2为IF1数据B2寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>DATA7</name>
              <description>CAN帧数据Byte 7。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>DATA6</name>
              <description>CAN帧数据Byte 6。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>IF2_COMMAND_REQUEST</name>
          <addressOffset>0x0080</addressOffset>
          <description>IF2_COMMAND_REQUEST为IF2命令请求寄存器。</description>
          <size>32</size>
          <resetValue>0x00000001</resetValue>
          <fields>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>BUSY</name>
              <description>Busy标志。
0：IF2命令已经完成；
1：IF2命令执行中。</description>
            </field>
            <field>
              <bitOffset>6</bitOffset>
              <bitWidth>9</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>Message Number</name>
              <description>报文对象序号。CPU写该位域后，IF2命令开始执行。
0x00：无效值，将指向0x20；
0x01～0x20：报文对象序号；
0x21~0x3F：无效值，将指向0x01~0x1F。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>IF2_COMMAND_MASK</name>
          <addressOffset>0x0084</addressOffset>
          <description>IF2_COMMAND_MASK为IF2命令掩码寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>wr_rd</name>
              <description>读写命令，控制IF2报文缓冲寄存器和Message RAM传输方向。
0：读命令，将Message RAM中存储的报文对象回读到IF2报文缓冲寄存器；
1：写命令，将IF2报文缓冲寄存器写入到Message RAM中存储的报文对象。</description>
            </field>
            <field>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>mask</name>
              <description>命令掩码，控制IF2_MASK的传输。
当wr_rd寄存器为1，写命令时：
0：不写入，报文对象的ID Mask、mdir、mxtd不改变；
1：将IF2_MASK1和IF2_MASK2寄存器中的ID Mask、mdir、mxtd写入报文对象。
当wr_rd寄存器为0，读命令时：
0：不回读，IF2_MASK不改变；
1：将报文对象的ID Mask、mdir、mxtd回读到IF2_MASK1和IF2_MASK2寄存器中。</description>
            </field>
            <field>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>arb</name>
              <description>命令掩码，控制IF2_ARBITRATION的传输。
当wr_rd寄存器为1，写命令时：
0：不写入，报文对象的ID、dir、xtd、msgval不改变；
1：将IF2_ARBITRATION1和IF2_ARBITRATION2中的ID、dir、xtd、msgval位写入报文对象。
当wr_rd寄存器为0，读命令时：
0：不回读，IF2_ARBITRATION不改变；
1：将报文对象的ID、dir、xtd、msgval回读到IF2_ARBITRATION1和IF2_ARBITRATION2寄存器中。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>control</name>
              <description>命令掩码，控制IF2_MESSAGE_CONTROL的传输。
当wr_rd寄存器为1，写命令时：
0：不写入，报文对象中的IF2_MESSAGE_CONTROL相关bit位不改变；
1：将IF2_MESSAGE_CONTROL的bit位写入报文对象。
当wr_rd寄存器为0，读命令时：
0：不回读，IF2_MESSAGE_CONTROL不改变；
1：将报文对象中的相应bit位回读到IF2_MESSAGE_CONTROL寄存器中。</description>
            </field>
            <field>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>clrintpnd</name>
              <description>命令掩码，清除报文对象的中断待处理。
当wr_rd寄存器为1，写命令时：
该位域忽略。
当wr_rd寄存器为0，读命令时：
0：报文对象的intpnd位保持不变；
1：清除报文对象的intpnd位。</description>
            </field>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>txrqst_newdat</name>
              <description>命令掩码，控制报文对象的txrqst位或者NewDat位。
当wr_rd寄存器为1时，写命令时：
访问txrqst位。
0：报文对象txrqst位保持不变；
1：置位报文对象的txrqst位，请求报文发送。
当wr_rd寄存器为0时，读命令时：
访问newdat位。
0：报文对象的newdat位保持不变；
1：清除报文对象的newdat位。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>DataA</name>
              <description>命令掩码，控制IF2_DATAA的传输。
当wr_rd寄存器为1时，写命令时：
0：报文对象中的数据Byte 0～3保持不变；
1：将IF2_DATAA寄存器写入报文对象，更新报文对象中的数据Byte0~3。
当wr_rd寄存器为0时，读命令时：
0：IF2_DATAA寄存器保持不变；
1：将报文对象中的数据Byte0~3回读到IF2_DATAA寄存器中。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>DataB</name>
              <description>命令掩码，控制IF2_DATAB的传输。
当wr_rd寄存器为1时，写命令时：
0：报文对象中的数据Byte 4～7保持不变；
1：将IF2_DATAB寄存器写入报文对象，更新报文对象中的数据Byte4~7。
当wr_rd寄存器为0时，读命令时：
0：IF2_DATAB寄存器保持不变；
1：将报文对象中的数据Byte4~7回读到IF2_DATAB寄存器中。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>IF2_MASK1</name>
          <addressOffset>0x0088</addressOffset>
          <description>IF2_MASK1为IF2掩码寄存器1。</description>
