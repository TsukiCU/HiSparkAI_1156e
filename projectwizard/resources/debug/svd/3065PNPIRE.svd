              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>release_substep</name>
              <description>版本信息。</description>
            </field>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
              <name>year</name>
              <description>年。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
              <name>month_day</name>
              <description>月日。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>QEMUMODE</name>
          <addressOffset>0x0004</addressOffset>
          <description>QEMUMODE为QDM Emulation Mode。仿真器模式配置寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>30</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>emu_mode</name>
              <description>QDM 仿真器接入模式。
00：内部计数器（QPOSCNT、QUTMR、QCTMR）当仿真器暂停CPU时，立即停止；
01：QPOSCNT达到最大值复位后，停止；QUTMR当前周期计数完成后，停止；QCTMR在下一个UTTRG后，停止；
10：内部计数器不受仿真器暂停CPU的影响；
11：与10一致。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>QCTRL</name>
          <addressOffset>0x0008</addressOffset>
          <description>QCTRL为QDM Control。QDM控制寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>14</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>qdu_mode</name>
              <description>QDM解码模式。
00：正交输入解码模式。输入为正交编码器A，B，Z相信号；
01：脉冲方向输入解码模式。输入为脉冲，方向信号；
10：非标准TYPE1输入解码模式；
11：非标准TYPE2输入解码模式。</description>
            </field>
            <field>
              <bitOffset>12</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>qdu_xclk</name>
              <description>QDM位置脉冲倍频解码。
00：1X倍频。A相上升沿；
01：2X倍频。A相双沿；
10：4X倍频。A相和B相双沿。仅当qdu_mode为正交输入解码模式时才有效，其他模式时是2X倍频；
11：保留。</description>
            </field>
            <field>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>qdm_ab_swap</name>
              <description>QDM A相B相（经过极性选择后）信号交换。
0：不交换；
1：交换。</description>
            </field>
            <field>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>qdma_polarity</name>
              <description>QDM A相输入极性选择。
0：直通；
1：取反。</description>
            </field>
            <field>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>qdmb_polarity</name>
              <description>QDM B相输入极性选择。
0：直通；
1：取反。</description>
            </field>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>qdmi_polarity</name>
              <description>QDM Z相（Index）输入极性选择。
0：直通；
1：取反。</description>
            </field>
            <field>
              <bitOffset>5</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>qtrg_lock_mode</name>
              <description>QDM触发锁存模式选择。
0：当总线（CPU/DMA）读QPOSCNT时：锁存位置计数QPOSCNT到QPOSLOCK；
1：当周期触发单元PTU使能且周期触发信号有效时：锁存位置计数QPOSCNT到QPOSLOCK。</description>
            </field>
            <field>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>ptu_mode</name>
              <description>QDM PTU工作模式。
0：周期工作模式。产生周期trigger信号；
1：看门狗工作模式。监控输入信号，用于失速检测。</description>
            </field>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>tsu_en</name>
              <description>QDM TSU时间戳单元使能。
0：不使能。TSU停止计数；
1：使能。TSU开始计数。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>ppu_en</name>
              <description>QDM位置处理单元PPU使能。
0：不使能 QDM PPU。PPU停止计数；
1：使能 QDM PPU。PPU开始计数。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>ptu_en</name>
              <description>QDM周期触发单元PTU使能。
0：不使能 QDM PTU。PTU停止计数；
1：使能 QDM PTU。PTU开始计数。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>QPPUCTRL</name>
          <addressOffset>0x000C</addressOffset>
          <description>QPPUCTRL为QDM Position Process Unit Control，PPU控制寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>29</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>pcnt_sw_init</name>
              <description>软件初始化位置计数器。
0：软件不初始化位置计数器；
1：软件初始化位置计数器，QPOSCNT=QPOSINIT。软件写1后不会自动清零。</description>
            </field>
            <field>
              <bitOffset>26</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>pcnt_mode</name>
              <description>位置计数器计数模式。
00：xCLK-xDIR计数模式。对解码后的xCLK，xDIR计数。xDIR为0时，表示逆时针旋转，计数器减计数。反之，增计数；
01：增计数模式。对QDMA增计数；
10：减计数模式。对QDMA减计数；
11：同00。</description>
            </field>
            <field>
              <bitOffset>24</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>pcnt_rst_mode</name>
              <description>QDM位置计数器复位选择。
00：硬件全自动校准（Z相标记点复位）；
01：溢出复位（上溢出后清零，下溢出后置位到qposmax）；
10：硬件单次校准（硬件校准一次后，溢出复位）；
11：单位时间触发（PTU触发）。</description>
            </field>
            <field>
              <bitOffset>22</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>pcnt_idx_init_mode</name>
              <description>QDM Z相（Index）初始化位置计数器模式。
00：不使能；
01：硬件全自动初始化（Z相标记点初始化），将QPOSCNT初始化为QPOSINIT（优先级低于复位）；
10：Z相（Index）上升沿时，将QPOSCNT初始化为QPOSINIT；
11：Z相（Index）下降沿时，将QPOSCNT初始化为QPOSINIT。</description>
            </field>
            <field>
              <bitOffset>20</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>pcnt_idx_lock_mode</name>
              <description>QDM Z相（Index）锁存模式选择。（锁存PPU位置计数器QPOSCNT到QPOSILOCK中）。
00：同11；
01：在Z相(Index)上升沿处锁存；
10：在Z相(Index)下降沿处锁存；
11：在Z相标记点锁存。</description>
            </field>
            <field>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>ppu_cmpshd_en</name>
              <description>QDM位置比较缓存寄存器的使能。
0：不使能缓存寄存器；
1：使能缓存寄存器。</description>
            </field>
            <field>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>ppu_cmpshd_ld</name>
              <description>QDM位置比较缓存寄存器load模式。
0：当QPOSCNT等于0时，把位置比较缓存寄存器load进位置比较active寄存器；
1：当比较成功时，把位置比较缓存寄存器load进位置比较active寄存器。</description>
            </field>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>ppu_poscmp_en</name>
              <description>QDM位置比较功能使能。
0：不使能位置比较功能；
1：使能位置比较功能。</description>
            </field>
            <field>
              <bitOffset>14</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>syncout_en</name>
              <description>QDM位置比较同步输出（syncout）使能。
0：不使能同步输出功能；
1：使能同步输出功能。</description>
            </field>
            <field>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>ppu_syncout_pl</name>
              <description>QDM位置比较同步输出（syncout）极性。
0：高有效脉冲输出；
1：低有效脉冲输出。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>ppu_syncout_pw</name>
              <description>QDM位置比较同步输出（syncout）脉宽选择。
0x000：1×4个时钟周期；
0x001：2×4个时钟周期；
0x002：3×4个时钟周期；
0x003：4×4个时钟周期；
…
0xFFF：4096×4个时钟周期。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>QTSUCTRL</name>
          <addressOffset>0x0010</addressOffset>
          <description>QTSUCTRL为QDM Time Stamp Unit Control，TSU控制寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>9</bitOffset>
              <bitWidth>23</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>qtmr_lock_mode</name>
              <description>QDM TSU锁存模式。
0：软件读QPOSCNT时，锁存QCTMR到QCTMRLOCK，锁存QCPRD到QCPRDLOCK；
1：单位时间触发信号有效时，锁存QCTMR到QCTMRLOCK，锁存QCPRD到QCPRDLOCK。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>tsu_prescaler</name>
              <description>QDM TSU计时步长选择。
0x0：等于时钟周期；
0x1：2倍时钟周期；
0x2：4倍时钟周期；
0x3：8倍时钟周期；
0x4：16倍时钟周期；
0x5：32倍时钟周期；
0x6：64倍时钟周期；
0x7：128倍时钟周期；
0x8：256倍时钟周期；
其他：256倍时钟周期。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>cevt_prescaler</name>
              <description>QDM捕获事件CEVT分频选择。
0x0：捕获事件频率 = xCLK不分频；
0x1：捕获事件频率 = xCLK的2分频；
0x2：捕获事件频率 = xCLK的4分频；
0x3：捕获事件频率 = xCLK的8分频；
0x4：捕获事件频率 = xCLK的16分频；
0x5：捕获事件频率 = xCLK的32分频；
0x6：捕获事件频率 = xCLK的64分频；
0x7：捕获事件频率 = xCLK的128分频；
0x8：捕获事件频率 = xCLK的256分频；
0x9：捕获事件频率 = xCLK的512分频；
0xA：捕获事件频率 = xCLK的1024分频；
0xB：捕获事件频率 = xCLK的2048分频；
其他：保留。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>QINTENA</name>
