      <name>UART1</name>
      <baseAddress>0x14001000</baseAddress>
    </peripheral>
    <peripheral derivedFrom="UART0">
      <name>UART2</name>
      <baseAddress>0x14002000</baseAddress>
    </peripheral>
    <peripheral derivedFrom="UART0">
      <name>UART3</name>
      <baseAddress>0x14003000</baseAddress>
    </peripheral>
    <peripheral derivedFrom="UART0">
      <name>UART4</name>
      <baseAddress>0x14004000</baseAddress>
    </peripheral>
    <peripheral>
      <name>SPI0</name>
      <description>SPI0 peripheral interface</description>
      <groupName>SPI</groupName>
      <baseAddress>0x14200000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x34</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>SPICR0</name>
          <addressOffset>0x000</addressOffset>
          <description>SPICR0为控制寄存器0。</description>
          <size>16</size>
          <resetValue>0x0000</resetValue>
          <fields>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>scr</name>
              <description>串行时钟率，取值范围0～255。scr的值用来产生SPI发送和接收的速率，公式为Fclk_spi/( cpsdvsr x (1+scr))?
cpsdvsr是一个2～254之间的偶数，由寄存器SPICPSR配置。</description>
            </field>
            <field>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>sph</name>
              <description>SPICLKOUT相位，具体含义请参见“21.4 接口时序”的SPI帧格式。</description>
            </field>
            <field>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>spo</name>
              <description>SPICLKOUT极性，具体含义请参见“21.4 接口时序”的SPI帧格式。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>frf</name>
              <description>帧格式选择。
00：Motorola SPI帧格式；
01：TI同步串行帧格式；
10：National Microwire帧格式；
11：保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>dss</name>
              <description>设置数据位宽。
0x3：4bit；
0x4：5bit；
0x5：6bit；
0x6：7bit；
0x7：8bit；
0x8：9bit；
0x9：10bit；
0xA：11bit；
0xB：12bit；
0xC：13bit；
0xD：14bit；
0xE：15bit；
0xF：16bit；
其他：保留。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>SPICR1</name>
          <addressOffset>0x004</addressOffset>
          <description>SPICR1为控制寄存器1。</description>
          <size>16</size>
          <resetValue>0x7F00</resetValue>
          <fields>
            <field>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>waiten</name>
              <description>等待使能，当SPICR1寄存器的sm配置为Master模式且SPICR0寄存器的frf配置为Microwire帧格式时有效。
0：不使能；
1：使能。</description>
            </field>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>waitval</name>
              <description>Microwire帧格式时，写和读之间的等待拍数。当SPICR1寄存器的sm配置为Master模式且waiten为1并且帧格式为National Microwire时有效。
0x00：等待周期为1个工作时钟clk_spi；
0x01：等待周期为2个工作时钟clk_spi；
…
0x7F：等待周期为128个工作时钟clk_spi。</description>
            </field>
            <field>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>triwiretxoe</name>
              <description>三线模式数据线方向控制位。
0：双向数据线方向为接收；
1：双向数据线方向为发送。
只能在frf位域配置为Motorola SPI帧格式时使用。</description>
            </field>
            <field>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>triwire</name>
              <description>三线/四线模式配置位。
0：四线模式；
1：三线模式。
只能在frf位域配置为Motorola SPI帧格式时使用。</description>
            </field>
            <field>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>bitend</name>
              <description>数据正反序控制位。
0：数据顺序为MSB到LSB；
1：数据顺序为LSB到MSB。</description>
            </field>
            <field>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>ms</name>
              <description>设置Master或者Slave模式，此位只能在SPI不使能时改变。
0：Master模式；
1：Slave模式。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>sse</name>
              <description>设置SPI使能。
0：不使能；
1：使能。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>lbm</name>
              <description>设置环回模式。
0：正常的串行接口操作使能；
1：发送串行移位寄存器的输出在内部连接到接收串行移位寄存器的输入上。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>SPIDR</name>
          <addressOffset>0x008</addressOffset>
          <description>SPIDR为数据寄存器。</description>
          <size>16</size>
          <resetValue>0x0000</resetValue>
          <fields>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>data</name>
              <description>发送/接收FIFO。
读：从接收FIFO读出数据；
写：向发送FIFO写入数据。
如果数据bit数少于16则必须右对齐。SPI控制器发送时将忽略高位未使用的bit位，SPI控制器接收时则自动将数据右对齐。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>SPISR</name>
          <addressOffset>0x00C</addressOffset>
          <description>SPISR为状态寄存器。</description>
          <size>16</size>
          <resetValue>0x0003</resetValue>
          <fields>
            <field>
              <bitOffset>5</bitOffset>
              <bitWidth>11</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>bsy</name>
              <description>SPI忙标记。
0：空闲；
1：忙。</description>
            </field>
            <field>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>rff</name>
              <description>接收FIFO是否已满。
0：未满；
1：已满。</description>
            </field>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>rne</name>
              <description>接收FIFO是否未空。
0：已空；
1：未空。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>tnf</name>
              <description>发送FIFO是否未满。
0：已满；
1：未满。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>tfe</name>
              <description>发送FIFO是否已空。
0：未空；
1：已空。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>SPICPSR</name>
          <addressOffset>0x010</addressOffset>
          <description>SPICPSR为时钟分频寄存器。</description>
          <size>16</size>
          <resetValue>0x0000</resetValue>
          <fields>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>cpsdvsr</name>
              <description>时钟分频因子。此值必须是2～254之间的偶数，取决于输入时钟SPI_CLK的频率。最低位读作“0”。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>SPIIMSC</name>
          <addressOffset>0x014</addressOffset>
          <description>SPIIMSC为中断屏蔽寄存器。</description>
          <size>16</size>
          <resetValue>0x0000</resetValue>
          <fields>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>txim</name>
              <description>发送FIFO中断屏蔽。
0：发送FIFO中断被屏蔽，不使能；
1：发送FIFO中断未被屏蔽，使能。</description>
            </field>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>rxim</name>
              <description>接收FIFO中断屏蔽。
0：接收FIFO中断被屏蔽，不使能；
1：接收FIFO中断未被屏蔽，使能。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>rtim</name>
              <description>接收超时中断。
0：接收超时中断屏蔽，不使能；
1：接收超时中断不屏蔽，使能。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>rorim</name>
              <description>接收溢出中断屏蔽。
0：接收FIFO溢出中断屏蔽，不使能；
1：接收FIFO溢出中断不屏蔽，使能。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>SPIRIS</name>
          <addressOffset>0x018</addressOffset>
          <description>SPIRIS为原始中断状态寄存器。值“0”表示无中断，值“1”表示有中断。</description>
          <size>16</size>
          <resetValue>0x0008</resetValue>
          <fields>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>txris</name>
              <description>发送FIFO中断的原始中断状态。
0：大于SPITXFIFOCR[txintsize]中配置的中断水线；
1：等于或小于SPITXFIFOCR[txintsize]中配置的中断水线。</description>
            </field>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>rxris</name>
              <description>接收FIFO中断的原始中断状态。
0：小于SPIRXFIFOCR[rxintsize]中配置的中断水线；
1：等于或大于SPIRXFIFOCR[rxintsize]中配置的中断水线。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>rtris</name>
              <description>接收超时中断的原始中断状态。当接收FIFO非空且SPI_CLK未发生翻转，超过64个SPI工作时钟周期时，此位域置1。对SPIICR[rtic]写1，可清除此位域。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>rorris</name>
              <description>接收溢出中断的原始中断状态。当接收FIFO已满且额外的数据被接收时，发生溢出中断，此位域置1。对SPIICR[roric]写1，可清除此位域。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>SPIMIS</name>
          <addressOffset>0x01C</addressOffset>
          <description>SPIMIS为屏蔽后中断状态寄存器。值“0”表示无中断，值“1”表示有中断。</description>
          <size>16</size>
          <resetValue>0x0000</resetValue>
          <fields>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>txmis</name>
              <description>发送FIFO中断屏蔽后的状态。</description>
            </field>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>rxmis</name>
              <description>接收FIFO中断屏蔽后的状态。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>rtmis</name>
              <description>接收超时中断屏蔽后的状态。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>rormis</name>
              <description>接收溢出中断屏蔽后的状态。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>SPIICR</name>
          <addressOffset>0x020</addressOffset>
          <description>SPIICR为中断清除寄存器。写“1”清除中断，写“0”无影响。</description>
          <size>16</size>
          <resetValue>0x0000</resetValue>
          <fields>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>14</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>clear</modifiedWriteValues>
              <name>rtic</name>
              <description>清除接收超时中断。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>clear</modifiedWriteValues>
              <name>roric</name>
              <description>清除接收溢出中断。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>SPIDMACR</name>
          <addressOffset>0x024</addressOffset>
          <description>SPIDMACR为DMA控制寄存器。</description>
          <size>16</size>
          <resetValue>0x0000</resetValue>
          <fields>
            <field>
              <bitOffset>3</bitOffset>
              <bitWidth>13</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留位。</description>
            </field>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>rxdmalsreqe</name>
              <description>接收 FIFO DMA外设流控（SPI流控）使能寄存器。当RX FIFO非空且SPI超时，LSREQ硬件请求线置1。
0：禁止；
1：使能。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>txdmae</name>
              <description>发送FIFO DMA请求使能寄存器。
0：禁止；
1：使能。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>rxdmae</name>
              <description>接收FIFO DMA请求使能寄存器。
0：禁止；
1：使能。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>SPITXFIFOCR</name>
          <addressOffset>0x028</addressOffset>
          <description>SPITXFIFOCR为发送FIFO控制寄存器。</description>
          <size>16</size>
          <resetValue>0x0001</resetValue>
          <fields>
            <field>
              <bitOffset>5</bitOffset>
              <bitWidth>11</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>txfiforst</name>
              <description>发送FIFO软复位配置位。
0：发送FIFO软复位；
1：发送FIFO解除软复位。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>txintsize</name>
              <description>配置发送FIFO的水线。当发送FIFO中的数据个数满足条件时，产生发送 FIFO中断（TXRIS）。如果使能了发送FIFO DMA功能，同时产生发送FIFO DMA burst传输请求。
0x0：等于0；
0x1：小于或等于1；
0x2：小于或等于2；
0x3：小于或等于3；
…
0xF：小于或等于15。
如果DMA控制器配置为搬移FIFO的数据，那么发送FIFO的水线需要小于DMA控制器的Burst长度。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>SPIRXFIFOCR</name>
          <addressOffset>0x02C</addressOffset>
          <description>SPIRXFIFOCR为接收FIFO控制寄存器。</description>
          <size>16</size>
          <resetValue>0x0001</resetValue>
          <fields>
            <field>
              <bitOffset>5</bitOffset>
              <bitWidth>11</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>rxfiforst</name>
              <description>接收FIFO软复位配置位。
0：接收FIFO软复位；
1：接收FIFO解除软复位。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>rxintsize</name>
              <description>配置接收FIFO的水线。当接收FIFO中的数据个数满足条件时，产生接收 FIFO中断（RXRIS）。如果使能了接收FIFO DMA功能，产生接收FIFO DMA burst传输请求。
0x0：大于或等于0；
0x1：大于或等于1；
0x2：大于或等于2；
0x3：大于或等于3；
…
0xF：大于或等于15。
如果DMA控制器配置为搬移FIFO的数据，那么接收FIFO的水线需要大于DMA控制器的Burst长度。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>SPICSNCR</name>
          <addressOffset>0x030</addressOffset>
          <description>SPICSNCR为SPI片选选择寄存器。</description>
          <size>16</size>
          <resetValue>0x0000</resetValue>
          <fields>
            <field>
              <bitOffset>6</bitOffset>
              <bitWidth>10</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>spi_csn_mode</name>
              <description>配置SPI片选产生的方式。
00：自动。片选信号由MCU逻辑根据所选时序自动产生；
01：altasens模式。当采用Motorola SPI 帧格式时，片选信号由 SPI 使能信号控制，使能后，片选拉低，否则片选拉高；
10：受软件控制，置0；
11：受软件控制，置1。</description>
            </field>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>spi_csn_sel</name>
              <description>配置选择SPI片选。
00：片选0；
01：片选1；
其他：保留。</description>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral derivedFrom="SPI0">
      <name>SPI1</name>
      <baseAddress>0x14201000</baseAddress>
    </peripheral>
    <peripheral>
      <name>CAN</name>
      <description>CAN peripheral interface</description>
      <groupName>CAN</groupName>
      <baseAddress>0x14600000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x168</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CAN_CONTROL</name>
          <addressOffset>0x0000</addressOffset>
          <description>CAN_CONTROL为CAN 控制寄存器。</description>
          <size>32</size>
          <resetValue>0x00000001</resetValue>
          <fields>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>test</name>
              <description>测试模式使能。
0：不使能；
1：使能。</description>
            </field>
            <field>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>cce</name>
              <description>更改配置使能。
0：禁止，CPU不能写Bit_Timing寄存器；
1：使能，当init为1时，CPU能写Bit_Timing寄存器。</description>
            </field>
            <field>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>dar</name>
              <description>关闭自动重传。
0：开启自动重传，自动重传受干扰的报文；
1：关闭自动重传。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>eie</name>
              <description>错误中断使能。
0：禁止；
1：使能错误中断，CAN_STATUS寄存器中的BOff或EWarn变化时会产生中断。</description>
            </field>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>sie</name>
              <description>状态改变中断使能。
0：禁止；
1：使能状态改变中断，报文传输成功或检测到CAN总线错误时会产生中断。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>ie</name>
              <description>模块中断使能。
0：禁止；
1：使能，CAN模块中断总开关。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>init</name>
              <description>初始化使能。
0：禁止，此时CAN控制器正常工作；
1：使能，此时CAN控制器初始化。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>CAN_STATUS</name>
          <addressOffset>0x0004</addressOffset>
          <description>CAN_STATUS为CAN状态寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>boff</name>
              <description>Bus-off状态。
0：CAN模块不处于Bus-off状态；
1：CAN模块处于Bus-off状态。</description>
            </field>
            <field>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>ewarn</name>
              <description>警告状态。
0：所有错误计数器均未达到96；
1：至少有一个错误计数器达到96。</description>
            </field>
            <field>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>epass</name>
              <description>错误状态。
0：处于CAN协议所定义的主动错误；
1：处于CAN协议所定义的被动错误。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>rxok</name>
              <description>报文接收状态。
0：接收报文失败，rxok不会被CAN控制器复位；
1：接收报文成功（独立于报文接收过滤），rxok只有CPU可以清零。</description>
            </field>
            <field>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>txok</name>
              <description>报文发送状态。
0：发送报文失败，txok不会被CAN控制器复位；
1：发送报文成功（没有错误且被至少1个CAN节点应答），txok只有CPU可以清零。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>lec</name>
              <description>错误状态码，用来表示CAN总线上最后一次错误状态。
000：无错误；
001：填充错误；
010：形式错误；
011：应答错误；
100：bit1错误；
101：bit0错误；
110：CRC错误；
111：未使用，没有检测到CAN总线事件，CPU最后将此值写入lec。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>CAN_ERROR_COUNTER</name>
          <addressOffset>0x0008</addressOffset>
          <description>CAN_ERROR_COUNTER为CAN错误计数寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>rp</name>
              <description>被动错误接收状态。
0：接收错误计数器未达到CAN协议所定义的被动错误水线；
1：接收错误计数器达到CAN协议所定义的被动错误水线。</description>
            </field>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-only</access>
              <name>rec</name>
              <description>接收错误计数器。
有效值在0～127。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
              <name>tec</name>
              <description>发送错误计数器。
有效值在0～255。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>BIT_TIMING</name>
          <addressOffset>0x000c</addressOffset>
          <description>BIT_TIMING为位时间寄存器。</description>
          <size>32</size>
          <resetValue>0x00002301</resetValue>
          <fields>
            <field>
              <bitOffset>15</bitOffset>
              <bitWidth>17</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>12</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>tseg2</name>
              <description>相位缓冲段2。
配置值为0～7，实际值比配置值多1。</description>
            </field>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>tseg1</name>
              <description>相位缓冲段1。
配置值为1～15，实际值比配置值多1。</description>
            </field>
            <field>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>sjw</name>
              <description>再同步跳转宽度。
配置值为0～3，实际值比配置值多1。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>brp</name>
              <description>波特率系数。
配置值为0～63，实际值比配置值多1。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>CAN_INTERRUPT</name>
          <addressOffset>0x0010</addressOffset>
          <description>CAN_INTERRUPT为CAN中断寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
              <name>intId</name>
              <description>中断ID。
0x0000：无中断；
0x0001：中断源是第1个报文对象；
0x0002：中断源是第2个报文对象；
0x0003：中断源是第3个报文对象；
0x0004：中断源是第4个报文对象；
0x0005：中断源是第5个报文对象；
0x0006：中断源是第6个报文对象；
0x0007：中断源是第7个报文对象；
0x0008：中断源是第8个报文对象；
0x0009：中断源是第9个报文对象；
0x000A：中断源是第10个报文对象；
0x000B：中断源是第11个报文对象；
0x000C：中断源是第12个报文对象；
0x000D：中断源是第13个报文对象；
0x000E：中断源是第14个报文对象；
0x000F：中断源是第15个报文对象；
0x0010：中断源是第16个报文对象；
0x0011：中断源是第17个报文对象；
0x0012：中断源是第18个报文对象；
0x0013：中断源是第19个报文对象；
0x0014：中断源是第20个报文对象；
0x0015：中断源是第21个报文对象；
0x0016：中断源是第22个报文对象；
0x0017：中断源是第23个报文对象；
0x0018：中断源是第24个报文对象；
0x0019：中断源是第25个报文对象；
0x001A：中断源是第26个报文对象；
0x001B：中断源是第27个报文对象；
0x001C：中断源是第28个报文对象；
0x001D：中断源是第29个报文对象；
0x001E：中断源是第30个报文对象；
0x001F：中断源是第31个报文对象；
0x0020：中断源是第32个报文对象；
0x0021 ～ 0x7FFF：无效；
0x8000：状态中断；
0x8001~0xFFFF：无效。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>CAN_TEST</name>
          <addressOffset>0x0014</addressOffset>
          <description>CAN_TEST为CAN调试寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>rx</name>
              <description>CAN_RX管脚监控。
0：CAN总线为显性（CAN_RX=‘0’）；
1：CAN总线为隐形（CAN_RX=‘1’）。</description>
            </field>
            <field>
              <bitOffset>5</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>tx</name>
              <description>CAN_TX管脚控制。
00：不控制CAN_TX管脚；
01：采样点能被CAN_TX管脚监视；
10：CAN_TX管脚驱动显性值（‘0’）；
11：CAN_TX管脚驱动隐形值（‘1’）。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>lback</name>
              <description>Loop back模式使能。
0：禁止；
1：使能。</description>
            </field>
            <field>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>silent</name>
              <description>Silent模式使能。
0：禁止；
1：使能。</description>
            </field>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>basic</name>
              <description>Basic模式使能。
0：禁止；
1：使能，此时IF1寄存器用作Tx Buffer，IF2寄存器用作Rx Buffer。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>BRP_EXTENSION</name>
          <addressOffset>0x0018</addressOffset>
          <description>BRP_EXTENSION为BRP扩展寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>28</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>brpe</name>
              <description>波特率系数扩展。
扩展后的波特率系数有brpe和brp共同组成，其中高位是brpe，低位是brp。
此时，波特率系数的配置值最大可达到1023，实际值比配置值多1。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>IF1_COMMAND_REQUEST</name>
          <addressOffset>0x0020</addressOffset>
          <description>IF1_COMMAND_REQUEST为IF1命令请求寄存器。</description>
          <size>32</size>
          <resetValue>0x00000001</resetValue>
          <fields>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>busy</name>
              <description>Busy标志。在Basic模式下，该位域可读可写。
0：IF1命令已经完成；
1：IF1命令执行中。</description>
            </field>
            <field>
              <bitOffset>6</bitOffset>
              <bitWidth>9</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>message number</name>
              <description>报文对象序号。CPU写该位域后，IF1命令开始执行。
0x00：无效值，将指向0x20；
0x01 ～ 0x20：报文对象序号；
0x21 ~ 0x3F：无效值，将指向0x01 ~ 0x1F。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>IF1_COMMAND_MASK</name>
          <addressOffset>0x0024</addressOffset>
          <description>IF1_COMMAND_MASK为IF1命令掩码寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>wr_rd</name>
              <description>读写命令，控制IF1报文缓冲寄存器和Message RAM传输方向。
0：读命令，将Message RAM中存储的报文对象回读到IF1报文缓冲寄存器；
1：写命令，将IF1报文缓冲寄存器写入到Message RAM中存储的报文对象。</description>
            </field>
            <field>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>mask</name>
              <description>命令掩码，控制IF1_MASK的传输。
当wr_rd为1，写命令时：
0：不写入，报文对象的msk、mdir、mxtd不改变；
1：将IF1_MASK1和IF1_MASK2寄存器中的msk、mdir、mxtd写入报文对象。
当wr_rd为0，读命令时：
0：不回读，IF1_MASK不改变；
1：将报文对象的Msk、Mdir、mxtd回读到IF1_MASK1和IF1_MASK2寄存器中。</description>
            </field>
            <field>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>Arb</name>
              <description>命令掩码，控制IF1_ARBITRATION的传输。
当wr_rd寄存器为1，写命令时：
0：不写入，报文对象的ID、Dir、Xtd、MsgVal不改变；
1：将IF1_ARBITRATION1和IF1_ARBITRATION2中的ID、Dir、Xtd、MsgVal位写入报文对象。
当wr_rd寄存器为0，读命令时：
0：不回读，IF1_ ARBITRATION不改变；
1：将报文对象的ID、Dir、Xtd、MsgVal回读到IF1_ARBITRATION1和IF1_ARBITRATION2寄存器中。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>Control</name>
              <description>命令掩码，控制IF1_MESSAGE_CONTROL的传输。
当wr_rd寄存器为1，写命令时：
0：不写入，报文对象中的IF1_MESSAGE_CONTROL相关bit位不改变；
1：将IF1_MESSAGE_CONTROL的bit位写入报文对象。
当wr_rd寄存器为0，读命令时：
0：不回读，IF1_MESSAGE_CONTROL不改变；
1：将报文对象中的相应bit位回读到IF1_MESSAGE_CONTROL寄存器中。</description>
            </field>
            <field>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>ClrIntPnd</name>
              <description>命令掩码，清除报文对象的中断待处理。
当wr_rd寄存器为1，写命令时：
该位域忽略。
当wr_rd寄存器为0，读命令时：
0：报文对象的IntPnd位保持不变；
1：清除报文对象的IntPnd位。</description>
            </field>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>txrqst_NewDat</name>
              <description>命令掩码，控制报文对象的txrqst位或者NewDat位。
当wr_rd寄存器为1时，写命令时：
访问txrqst位。
0：将IF1_MESSAGE_CONTROL寄存器的txrqst位写入报文对象；
1：忽略IF1_MESSAGE_CONTROL寄存器的txrqst位。直接置位报文对象的txrqst位，请求报文发送。
当wr_rd为0时，读命令时：
访问newdat位，IF1_MESSAGE_CONTROL寄存器的newdata位不会被更新。
0：报文对象的newdat位均保持不变；
1：清除报文对象的newdat位。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>dataa</name>
              <description>命令掩码，控制IF1_DATAA的传输。
当wr_rd为1时，写命令时：
0：报文对象中的数据Byte 0～3保持不变；
1：将IF1_DATAA寄存器写入报文对象，更新报文对象中的数据Byte0~3。
当wr_rd寄存器为0时，读命令时：
0：IF1_DATAA寄存器保持不变；
1：将报文对象中的数据Byte0~3回读到IF1_DATAA寄存器中。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>DataB</name>
              <description>命令掩码，控制IF1_DATAB的传输。
当wr_rd寄存器为1时，写命令时：
0：报文对象中的数据Byte 4～7保持不变；
1：将IF1_DATAB寄存器写入报文对象，更新报文对象中的数据Byte4~7。
当wr_rd寄存器为0时，读命令时：
0：IF1_DATAB寄存器保持不变；
1：将报文对象中的数据Byte4~7回读到IF1_DATAB寄存器中。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>IF1_MASK1</name>
          <addressOffset>0x0028</addressOffset>
          <description>IF1_MASK1为IF1掩码寄存器1。</description>
          <size>32</size>
          <resetValue>0x0000FFFF</resetValue>
          <fields>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>Msk</name>
              <description>报文对象ID第15位至第0位掩码，用于报文接收过滤。
0：ID第15位至第0位不用于报文接收过滤；
1：ID第15位至第0位用于报文接收过滤。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>IF1_MASK2</name>
          <addressOffset>0x002c</addressOffset>
          <description>IF1_MASK2为IF1掩码寄存器2。</description>
          <size>32</size>
          <resetValue>0x0000FFFF</resetValue>
          <fields>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>MXtd</name>
              <description>报文对象的拓展ID位（Xtd）掩码，用于接收报文过滤。
0：Xtd不用于报文接收过滤；
1：Xtd用于报文接收过滤。</description>
            </field>
            <field>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>MDir</name>
              <description>报文对象的方向位（Dir）掩码，用于接收报文过滤。
0：Dir不用于报文接收过滤；
1：Dir用于报文接收过滤。</description>
            </field>
            <field>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>13</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>Msk</name>
              <description>报文对象ID第28位至第16位掩码，用于接收报文过滤。
0：ID第28位至第16位不用于报文接收过滤；
1：ID第28位至第16位用于报文接收过滤。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>IF1_ARBITRATION1</name>
          <addressOffset>0x0030</addressOffset>
          <description>IF1_ARBITRATION1为IF1仲裁寄存器1。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>ID</name>
              <description>报文对象的报文ID第15位至第0位。
注意：
当报文对象用于收发扩展帧时，应使用全部ID；当报文对象用于收发标准帧时，应使用IF1_ARBITRATION2[ID]的高11位。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>IF1_ARBITRATION2</name>
          <addressOffset>0x0034</addressOffset>
          <description>IF1_ARBITRATION2为IF1仲裁寄存器2。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>MsgVal</name>
              <description>报文对象有效使能。
0：禁止，该报文对象无效；
1：使能，该报文对象有效。</description>
            </field>
            <field>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>Xtd</name>
              <description>报文对象收发帧格式。
0：该报文对象收发标准格式帧；
1：该报文对象收发扩展格式帧。</description>
            </field>
            <field>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>Dir</name>
              <description>报文对象的方向。
0：报文对象为接收方向，接收报文；
1：报文对象为发送方向，发送报文。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>13</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>ID</name>
              <description>报文对象的报文ID第28位至第16位。
注意：
当报文对象用于收发扩展帧时，应使用全部ID；
当报文对象用于收发标准帧时，应使用IF2_ARBITRATION2[ID]的高11位</description>
            </field>
          </fields>
        </register>
        <register>
          <name>IF1_MESSAGE_CONTROL</name>
          <addressOffset>0x0038</addressOffset>
          <description>IF1_MESSAGE_CONTROL为IF1报文控制寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>NewDat</name>
              <description>报文对象的新数据写入状态。
报文对象为发送方向时：
0：无新的帧数据写入报文对象，报文对象成功发送后会清除报文对象中的NewDat；
1：有新的帧数据写入报文对象。
报文对象为接收方向时：
0：报文对象没有接收到新的帧；
1：报文对象接收到了新的帧。</description>
            </field>
            <field>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>MsgLst</name>
              <description>报文对象的报文丢失标识（仅在报文对象为接收方向时有效）。
0：报文对象无报文丢失；
1：报文对象有报文丢失，当报文对象的NewDat位未被清除，新的报文已接收时，报文对象的MsgLst置1。</description>
            </field>
            <field>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>IntPnd</name>
              <description>报文对象的中断待处理标识。
0：该报文对象不是中断源；
1：该报文对象是中断源。</description>
            </field>
            <field>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>Umask</name>
              <description>报文对象是否使用报文掩码，用于报文接收过滤。
0：不使用；
1：使用相关掩码位（Msk28～0，mxtd和Mdir用于报文接收过滤。</description>
            </field>
            <field>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>TxIE</name>
              <description>发送中断使能。
0：不使能，帧发送成功后IntPnd保持不变；
1：使能，帧发送成功后IntPnd将被至1。</description>
            </field>
            <field>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>RxIE</name>
              <description>接收中断使能。
0：不使能，帧接收成功后IntPnd保持不变；
1：使能，帧接收成功后IntPnd将被至1。</description>
            </field>
            <field>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>RmtEn</name>
              <description>远程帧使能。
0：不使能，接收远程帧后txrqst保持不变；
1：使能，接收远程帧后txrqst置1。</description>
            </field>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>txrqst</name>
              <description>传输请求。
0：该报文对象没在等待传输；
1：该报文对象请求传输，并且还没传输完成。</description>
            </field>
            <field>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>eob</name>
              <description>多报文接收模式。
0：该报文对象不是多报文接收模式中最后一个报文对象；
1：该报文对象是单一报文或是多报文接收模式中最后一个报文对象。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>DLC</name>
              <description>数据长度编码。
0x0～0x8：数据帧有0~8个数据字节；
0x9~0xF：数据帧有8个数据字节。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>IF1_DATAA1</name>
          <addressOffset>0x003c</addressOffset>
          <description>IF1_DATAA1为IF1数据A1寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
