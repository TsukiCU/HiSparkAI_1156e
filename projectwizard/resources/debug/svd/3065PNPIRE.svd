    <peripheral>
      <name>GPIO0</name>
      <description>GPIO0 peripheral interface</description>
      <groupName>GPIO</groupName>
      <baseAddress>0x14500000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x420</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <dim>256</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>0-255</dimIndex>
          <name>GPIO_DATA%s</name>
          <displayName>GPIO_DATA%s</displayName>
          <addressOffset>0x000</addressOffset>
          <description>GPIO_DATA为GPIO数据寄存器，用来对输入或输出数据进行缓存。</description>
          <size>8</size>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>gpio_data</name>
              <description>当GPIO配置为输入模式时，为GPIO输入数据；当GPIO配置为输出模式时，为输出数据。各比特均可独立控制。与GPIO_DIR配合使用。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIO_DIR</name>
          <addressOffset>0x400</addressOffset>
          <description>GPIO_DIR为GPIO方向控制寄存器。用来配置GPIO方向。</description>
          <size>8</size>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>gpio_dir</name>
              <description>GPIO方向控制寄存器。bit[7:0]分别对应GPIO_DATA[7:0]，各比特可独立控制。
0：输入；
1：输出。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIO_IS</name>
          <addressOffset>0x404</addressOffset>
          <description>GPIO_IS为GPIO中断触发寄存器。用来配置GPIO触发电平方式。</description>
          <size>8</size>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>gpio_is</name>
              <description>GPIO中断触发控制寄存器，bit[7:0]分别对应GPIO_DATAbit[7:0]，各比特独立控制。
0：边沿触发中断；
1：电平触发中断。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIO_IBE</name>
          <addressOffset>0x408</addressOffset>
          <description>GPIO_IBE为GPIO双沿触发中断寄存器。用来配置GPIO沿触发方式。</description>
          <size>8</size>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>gpio_ibe</name>
              <description>GPIO中断沿触发控制寄存器，bit[7:0]分别对应GPIO_DATAbit[7:0]，各比特独立控制。
0：单边沿触发中断，具体是上升沿还是下降沿触发由GPIO_IEV控制；
1：双边触发中断。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIO_IEV</name>
          <addressOffset>0x40C</addressOffset>
          <description>GPIO_IEV为GPIO触发中断条件寄存器。用来配置GPIO触发中断条件。</description>
          <size>8</size>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>gpio_iev</name>
              <description>GPIO触发中断条件寄存器，bit[7:0]分别对应GPIO_DATAbit[7:0]，各比特独立控制。
0：下降沿或低电平触发中断，具体由GPIO_IS控制；
1：上升沿或高电平触发中断。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIO_IE</name>
          <addressOffset>0x410</addressOffset>
          <description>GPIO_IE为GPIO中断屏蔽寄存器。用来屏蔽GPIO中断。</description>
          <size>8</size>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>gpio_ie</name>
              <description>GPIO中断屏蔽寄存器，bit[7:0]分别对应GPIO_DATAbit[7:0]，各比特独立控制。
0：屏蔽中断；
1：不屏蔽中断。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIO_RIS</name>
          <addressOffset>0x414</addressOffset>
          <description>GPIO_RIS为GPIO原始中断状态寄存器。用来查询GPIO原始中断状态。</description>
          <size>8</size>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
              <name>gpio_ris</name>
              <description>GPIO原始中断寄存器，bit[7:0]分别对应GPIO_DATAbit[7:0]，指示未屏蔽的中断状态。该状态不受GPIO_IE寄存器屏蔽控制。
0：未发生中断；
1：已发生中断。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIO_MIS</name>
          <addressOffset>0x418</addressOffset>
          <description>GPIO_MIS为GPIO屏蔽状态中断寄存器。用来查询GPIO屏蔽后的中断状态。对所有位进行或操作得到中断输出gpio_int。</description>
          <size>8</size>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
              <name>gpio_mis</name>
              <description>GPIO屏蔽后中断寄存器，bit[7:0]分别对应GPIO_DATAbit[7:0]，指示经屏蔽后的中断状态。该状态受GPIO_IE寄存器屏蔽控制。
0：中断无效；
1：中断有效。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIO_IC</name>
          <addressOffset>0x41C</addressOffset>
          <description>GPIO_IC为GPIO中断清除寄存器。用来清除GPIO产生的中断，同时清除GPIO_RIS寄存器和GPIO_MIS寄存器。</description>
          <size>8</size>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>clear</modifiedWriteValues>
              <name>gpio_ic</name>
              <description>GPIO中断清除寄存器，bit[7:0]分别对应GPIO_DATAbit[7:0]，各比特可独立控制。
0：无影响；
1：清除中断。</description>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral derivedFrom="GPIO0">
      <name>GPIO1</name>
      <baseAddress>0x14501000</baseAddress>
    </peripheral>
