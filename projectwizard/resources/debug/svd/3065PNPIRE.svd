              <description>CFD使能。
0：不使能；
1：使能。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>CFDWDOH</name>
          <addressOffset>0x0008</addressOffset>
          <description>CFDWDOH为CFD Check Window High Value，CFD检查窗口上限寄存器。</description>
          <size>32</size>
          <resetValue>0x0000001F</resetValue>
          <fields>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>cfdwdoh</name>
              <description>CFD检查窗口上界限，默认为32（从0x0计数到0x1F）个LOSC周期，即检测时间1ms，CFDCNTLOCK大于等于该值说明检测到PLL参考时钟失效（Clock_fail）。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>CFDCNTLOCK</name>
          <addressOffset>0x000C</addressOffset>
          <description>CFDCNTLOCK为CFD Count Lock Value，CFD计数锁存值寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
              <name>cfdcnt_lock</name>
              <description>CFD内部计数器计数锁存值。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>CFDINTENA</name>
          <addressOffset>0x0010</addressOffset>
          <description>CFDINTENA为CFD Interrupt Enable，CFD中断使能寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>30</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>clk_fail_en</name>
              <description>CFD检测到PLL参考时钟失效中断使能。不使能时，即屏蔽相应的中断状态，不影响相应的原始中断。若全部不使能，CFD不会上报中断给CPU。
0：不使能；
1：使能。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>chk_end_en</name>
              <description>CFD 检测结束中断使能。
0：不使能；
1：使能。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>CFDINTSTS</name>
          <addressOffset>0x0014</addressOffset>
          <description>CFDINTSTS为CFD Interrupt Status，CFD中断状态寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>30</bitWidth>
