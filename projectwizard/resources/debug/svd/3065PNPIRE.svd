0：未发生；
1：已发生。写1清零。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>clear</modifiedWriteValues>
