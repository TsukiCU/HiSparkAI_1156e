              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>hosc_lpfr_sel</name>
              <description>bit[3:2]：Reserved。
bit[1]：VREF RC short control signal。
0：RC short；
1：RC not short。
bit[0]：FS ENB signal。
0：FS enable；
1：FS disable。</description>
            </field>
            <field>
              <bitOffset>18</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
