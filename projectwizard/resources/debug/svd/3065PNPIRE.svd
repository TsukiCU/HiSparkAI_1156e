              <name>hosc_ctrim_value</name>
              <description>OSC25M frequency trimming controlled be Efuse bit[9:1]: 512 steps calib
Cdac= 1.542p+ 7.46f*ctrim[9:1]
bit[0]: 2 steps calib
Cdac= 3.725f*ctrim[0]</description>
            </field>
          </fields>
        </register>
        <register>
          <name>HOSC_CTRL2</name>
          <addressOffset>0x0F04</addressOffset>
          <description>HOSC_CTRL2为HOSC配置寄存器。</description>
          <size>32</size>
          <resetValue>0x0000306E</resetValue>
          <fields>
            <field>
              <bitOffset>24</bitOffset>
