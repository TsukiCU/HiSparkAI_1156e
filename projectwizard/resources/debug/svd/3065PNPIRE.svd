              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>dma_enable</name>
              <description>DMA控制器使能。
0：禁止DMA控制器；
1：使能DMA控制器。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>DMA_SYNC</name>
          <addressOffset>0x0034</addressOffset>
          <description>DMA_SYNC为DMA请求线同步使能寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>dma_sync_disable</name>
              <description>控制是否需要对请求线进行同步，每bit对应请求请参见11.3.2.2 外设请求线（SREQ、BREQ和外设流控请求线）章节。
0：使能对应外设的DMA请求信号同步逻辑；
1：禁止对应外设的DMA请求信号同步逻辑。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>DMA_C0_SRC_ADDR</name>
