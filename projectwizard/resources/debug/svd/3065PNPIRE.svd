      </addressBlock>
      <registers>
        <register>
          <name>EFLASH_CLK_CFG</name>
          <addressOffset>0x140</addressOffset>
          <description>EFLASH_CLK_CFG为时钟分频寄存器。</description>
          <size>32</size>
          <resetValue>0x00000020</resetValue>
          <fields>
            <field>
              <bitOffset>21</bitOffset>
              <bitWidth>11</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>busclk_sw_req</name>
              <description>nread_div是否切换完成配置查询寄存器。
写1后触发电路进行切换，回读判断是否切换完成。
读0：切换完成；
读1：切换未完成。</description>
            </field>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>nread_div</name>
              <description>Flash Read，系统总线主时钟与Flash时钟比值（n+1）。
0x0：1分频；
0x1：2分频；
……
0xF：16分频。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>READ_QOS</name>
          <addressOffset>0x188</addressOffset>
          <description>READ_QOS为读QOS配置寄存器。</description>
          <size>32</size>
          <resetValue>0x01002001</resetValue>
          <fields>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>pe_wait_timeout_cylces</name>
              <description>pe_wait使能后，PE（Program and Erase）请求被阻塞cycle超过pe_wait_timeout_cylces+pe_wait_cycles，提高PE请求优先级，优先响应PE请求。</description>
            </field>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>pe_wait_cycle</name>
              <description>为避免稀疏的Read操作被PE操作阻塞，在完成Read操作后维持pe_wait_cycle个cycle（总线时钟），在此期间阻塞PE请求。
0表示不阻塞。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>pe_wait_en</name>
              <description>PE_wait功能使能。
0：不使能；
1：使能，Read结束后，在pe_wait_cycle时间内，阻塞PE请求，在此cycle内入股有新的Read请求，会优先响应Read。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>LOW_POWER_CFG</name>
          <addressOffset>0x200</addressOffset>
          <description>LOW_POWER_CFG为低功耗控制寄存器。</description>
          <size>32</size>
          <resetValue>0x00000100</resetValue>
          <fields>
            <field>
              <bitOffset>17</bitOffset>
              <bitWidth>15</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>auto_sleep_en</name>
              <description>自动休眠低功耗功能控制。
0：关闭；
1：开启，当Main状态机IDLE时间超过sleep_cnt阈值时，逻辑自动控制Macro进入DPD（Deep Power Down）模式。</description>
            </field>
            <field>
              <bitOffset>10</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>sram_ck_gt_en</name>
              <description>内部SRAM时钟动态门控使能控制。
0：SRAM时钟常开；
1：SRAM时钟动态门控，需要读写时逻辑自动打开，读写结束自动关闭。</description>
            </field>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>apb_cmd_clk_en</name>
              <description>Flash CMD相关逻辑时钟使能控制。
0：关闭Erase/Program相关数字逻辑时钟；
1：打开Erase/Program相关数字逻辑时钟。</description>
            </field>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>switch_lp_mode</name>
              <description>软件直接控制低功耗切换。
00：操作完成；
01：唤醒；
10：睡眠；
11：保留。
软件写入非0值，触发状态跳转，跳转完成寄存器自动回到0。</description>
            </field>
          </fields>
        </register>
        <register>
