    <peripheral>
      <name>TIMER0</name>
      <description>TIMER0 peripheral interface</description>
      <groupName>TIMER</groupName>
      <baseAddress>0x14300000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x24</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>TIMERx_LOAD</name>
          <addressOffset>0x000</addressOffset>
          <description>TIMERx_LOAD为计数初值寄存器。用来配置定时器的计数初值。 向TIMERx_LOAD寄存器写入的最小有效值为1。
当向TIMERx_LOAD写0时，TIMER将会立刻产生1个中断。
</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>timerload</name>
              <description>TIMER的计数初值。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>TIMERx_VALUE</name>
          <addressOffset>0x004</addressOffset>
          <description>TIMERx_VALUE为当前计数值寄存器。用于给出正在递减的计数器的当前值。当向TIMERx_LOAD寄存器的写操作发生后，TIMERx_VALUE立刻反映出计数器的新载入值。</description>
          <size>32</size>
          <resetValue>0xFFFFFFFF</resetValue>
          <fields>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
              <name>timervalue</name>
              <description>TIMERx当前计数值。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>TIMERx_CONTROL</name>
          <addressOffset>0x008</addressOffset>
          <description>TIMERx_CONTROL为TIMER控制寄存器。 当选择用周期模式进行计数时，需要将TIMERx_CONTROL.timermode置1、TIMERx_CONTROL.oneshot置0。
</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>timeren</name>
              <description>定时器使能。
0：TIMER禁止；
1：TIMER使能。</description>
            </field>
            <field>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>timermode</name>
              <description>定时器的计数模式。
0：自由运行模式；
1：周期模式。</description>
            </field>
            <field>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>timerintenable</name>
              <description>定时中断屏蔽。
0：屏蔽该中断；
1：不屏蔽该中断。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>dmaovintenable</name>
              <description>DMA请求溢出中断屏蔽。
0：屏蔽该中断；
1：不屏蔽该中断。</description>
            </field>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>timerpre</name>
              <description>该字段用于设置TIMER的预分频系数。
00：对clk_sys进行1倍预分频；
01：对clk_sys进行16倍预分频；
10：对clk_sys进行256倍预分频；
11：对clk_sys进行256倍预分频。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>timersize</name>
              <description>选择16bit/32bit计数器操作模式。
0：16bit计数器；
1：32bit计数器。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>oneshot</name>
              <description>选择计数模式为单次计数模式还是周期计数模式。
0：周期计数模式或自由运行模式；
1：单次计数模式。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>TIMERx_INTCLR</name>
          <addressOffset>0x00C</addressOffset>
          <description>TIMERx_INTCLR为中断清除寄存器。对该寄存器的任何写操作都会清除相应计数器的中断状态。 本寄存器是只写寄存器，写进去任意值，都会引起TIMER清中断。
</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>timerintclr</name>
              <description>写该寄存器，清除TIMERx的中断输出。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>TIMERx_RIS</name>
          <addressOffset>0x010</addressOffset>
          <description>TIMERx_RIS为原始中断寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>30</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>dmaovris</name>
              <description>DMA请求溢出中断的原始中断状态。
0：未产生中断；
1：已产生中断。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>timerris</name>
              <description>定时中断的原始中断状态。
0：未产生中断；
1：已产生中断。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>TIMERx_MIS</name>
          <addressOffset>0x014</addressOffset>
          <description>TIMERx_MIS为屏蔽后中断寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>30</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>dmaovmis</name>
              <description>屏蔽后的DMA请求溢出中断状态。
0：中断无效；
1：中断有效。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>timermis</name>
              <description>屏蔽后的定时中断状态。
0：中断无效；
1：中断有效。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>TIMERx_BGLOAD</name>
          <addressOffset>0x018</addressOffset>
          <description>TIMERx_BGLOAD为计数周期值寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>timerbgload</name>
              <description>TIMERx的计数周期值。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>TIMERx_CONTROLB</name>
          <addressOffset>0x01C</addressOffset>
          <description>TIMERx_CONTROLB为TIMER的DMA/ADC控制寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>3</bitOffset>
              <bitWidth>29</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>socen</name>
              <description>触发ADC采样信号（SOC信号）使能位。
0：计数器计到0时禁止产生SOC信号；
1：计数器计到0时可以产生SOC信号。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>dmasreqen</name>
              <description>DMA Single请求使能位。
0：计数器计到0时禁止产生DMA Single请求；
1：计数器计到0时可以产生DMA Single请求。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>dmabreqen</name>
              <description>DMA Burst 请求使能位。
0：计数器计到0时禁止产生DMA Burst请求；
1：计数器计到0时可以产生DMA Burst请求。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>TIMERx_DMAOVINTCLR</name>
          <addressOffset>0x020</addressOffset>
          <description>TIMERx_DMAOVINTCLR为TIMER的DMA请求溢出中断清除寄存器。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>31</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>dmaov_intclr</name>
              <description>DMA请求溢出中断清除位。
0：写0无效；
1：写1清零。</description>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral derivedFrom="TIMER0">
