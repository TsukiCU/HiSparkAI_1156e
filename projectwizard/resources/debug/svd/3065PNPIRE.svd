              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>hosc_start_up</name>
              <description>Output reset signal。
0：disabled；
1：reset vctrl in OSC analog phy。
Reserved</description>
            </field>
            <field>
              <bitOffset>18</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>16</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>hosc_div_sel</name>
              <description>Select mode of internal divider for CLK_DIV_OUT。
00：1024；
01：2048；
10：512；
11：256。</description>
            </field>
            <field>
              <bitOffset>14</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>10</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>hosc_test</name>
              <description>bit[9]：select IBIAS bypass signal。
0：use normal mode；
1：use bypass mode。
bit[8]：select LDO bypass signal。
0：use normal mode；
1：use bypass mode。
bit[7]：reserved。
bit[6]：select ad_test_dig signal。
0：use CLK_DIV_OUT；
1：use CLK_OUT。
bit[5:3]：select test_analog signal。
000：reserved；
001：test avdd18；
010：test vctrl；
011：test vring；
100：test vref；
101：test lock；
110：test reset18；
111：test fs_ctl18。
bit[2]：Voltage divider control signal。
0：test voltage halved；
1：test voltage not divided 。
bit[1]：select test voltage output mode。
0：direct output ；
1：OP buffer。
bit[0]：analog test control signal。
0：analog test disable；
1：analog test enable。</description>
            </field>
            <field>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>hosc_dft_en</name>
              <description>Flag of DFT mode。
0：when REG_ATE_EN=0,CLK_OUT_ANALOG=CLK_OSC
When REG_ATE_EN=1, CLK_OUT_ANALOG=CLK_XTAL；
1：CLK_OUT_ANALOG=CLK_OSC。</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>hosc_ate_en</name>
              <description>Switch to ATE mode。
0：not in ATE mode；
1：in ATE mode。</description>
            </field>
          </fields>
        </register>
