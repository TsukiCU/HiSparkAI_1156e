            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>pcnt_err_en</name>
              <description>QDM位置计数错误中断使能。
0：不使能；
1：使能。</description>
            </field>
          </fields>
