            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
              <name>chk_end_inj</name>
              <description>CFD检测结束中断注入。
0：不注入；
1：注入。</description>
            </field>
          </fields>
        </register>
      </registers>
