            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>spcfg</name>
              <description>配置过采样倍数。
0x0：16倍过采样；
0x1：15倍过采样；
0x2：14倍过采样；
0x3：13倍过采样；
0x4：12倍过采样；
0x5：11倍过采样；
0x6：10倍过采样；
0x7：9倍过采样；
0x8：8倍过采样；
其他：禁止配置。</description>
            </field>
          </fields>
        </register>
        <register>
          <name>UART_ABDEN</name>
          <addressOffset>0x05C</addressOffset>
          <description>UART_ABDEN为自动波特率检测使能寄存器，用于配置自动波特率检测使能。</description>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <bitOffset>6</bitOffset>
              <bitWidth>26</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留。</description>
            </field>
            <field>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>abdenvld</name>
              <description>abden已经有效的标志。
0：abden还未生效；
1：abden已经生效，UART可以接收大写字符Z进行自动波特率检测。</description>
            </field>
            <field>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <name>abdbusy</name>
              <description>自动波特率检测忙标志。
0：不在进行自动波特率检测；
1：正在进行自动波特率检测。</description>
            </field>
            <field>
              <bitOffset>1</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-only</access>
              <name>reserved</name>
              <description>保留</description>
            </field>
            <field>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
              <name>abden</name>
              <description>自动波特率检测使能。
0：禁止自动波特率检测；
1：使能自动波特率检测。
如果UART_CR[uarten]使能，且使能UART_CR[rxe]或UART_CR[txe]，则abden会被自动清零。</description>
            </field>
          </fields>
        </register>
