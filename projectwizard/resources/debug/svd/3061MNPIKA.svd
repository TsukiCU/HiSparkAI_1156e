              <bitWidth>10</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>slv_busy</name>
              <description>Slave忙。Slave检测到总线上有START条件且地址匹配后，Slave进入忙状态。Slave检测到总线上有STOP条件，或者Slave执行S命令，或者Slave执行P命令，Slave退出忙状态。
0：Slave空闲；
1：Slave忙。</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>slv_cmd_exe</name>
              <description>Slave正在执行的时序命令。时序命令的具体含义，请见mst_slv_cmd位域。</description>
              <bitOffset>21</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>reserved</name>
              <description>保留。</description>
              <bitOffset>15</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>mst_busy</name>
              <description>Master忙。Master执行S命令后，Master进入忙状态。Master仲裁丢失或者Master执行完成P命令后，Master退出忙状态。
0：Master空闲；
1：Master忙。</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>mst_cmd_exe</name>
              <description>Master正在执行的时序命令。时序命令的具体含义，请见mst_slv_cmd位域。</description>
              <bitOffset>10</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
