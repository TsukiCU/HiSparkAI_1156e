          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>dma_c5_dest_addr_dest_addr</name>
              <description>DMA目的地址。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>DMA_C5_LLI</name>
          <displayName>DMA_C5_LLI</displayName>
          <description>DMA通道5链表信息寄存器。</description>
          <addressOffset>0x1a8</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
