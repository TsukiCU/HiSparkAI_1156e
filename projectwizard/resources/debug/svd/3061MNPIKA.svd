              <name>crc_pre_byte_reverse</name>
              <description>crc_data_in数据在字节内，按位反序（RefIn）：
0：不反序；
1：反序。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
          </fields>
