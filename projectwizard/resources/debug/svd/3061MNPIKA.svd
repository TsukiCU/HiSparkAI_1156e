              <name>cfg_soc0_cont_en</name>
              <description>SOC0连续转换模式使能。
0：不使能；
1：使能。</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
            <field>
              <name>cfg_soc0_trig_sel</name>
              <description>SOC0触发源选择。
0x00：软件触发；
0x01：APT0_ADCA；
0x02：APT0_ADCB；
0x03：APT1_ADCA；
0x04：APT1_ADCB；
0x05：APT2_ADCA；
0x06：APT2_ADCB；
0x07：APT3_ADCA；
0x08：APT3_ADCB；
0x09：GPT0；
0x0A：GPT1；
0x0B：GPT2；
0x0C：GPT3；
0x0D：TIMER0；
0x0E：TIMER1；
0x0F：TIMER2；
0x10：TIMER3；
0x11：GPIO；
0x12：GPIO；
0x13：GPIO；
0x14：GPIO；
其他：软件触发。</description>
              <bitOffset>9</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
            <field>
              <name>cfg_soc0_samptime_sel</name>
              <description>SOC0采样周期选择。
0x0：5clk；
0x1：7clk；
0x2：10clk；
0x3：12clk；
0x4：15clk；
0x5：22clk；
0x6：30clk；
0x7：50clk；
0x8：75clk；
0x9：100clk；
0xA：125clk；
0xB：150clk；
0xC：200clk；
0xD：300clk；
0xE：400clk；
0xF：500clk。</description>
              <bitOffset>5</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
            <field>
              <name>cfg_soc0_ch_sel</name>
              <description>SOC0通道选择。
0x00：PGA0_OUT；
0x01：PGA1_OUT；
0x02：管脚输入；
0x03：管脚输入；
0x04：管脚输入；
0x05：管脚输入；
0x06：管脚输入；
0x07：管脚输入；
0x08：管脚输入；
0x09：管脚输入；
0x0A：管脚输入；
0x0B：管脚输入；
0x0C：管脚输入；
0x0D：管脚输入；
0x0E：管脚输入；
0x0F：管脚输入；
0x10：TSENSOR_OUT；
0x11：DAC_OUT；
0x12：AVDD/3；
其他：未使用。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
          </fields>
        </register>
