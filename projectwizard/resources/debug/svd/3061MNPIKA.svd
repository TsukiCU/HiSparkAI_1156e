    <peripheral>
      <name>FLASH_RGN1_SHADOWS</name>
      <description>FLASH_RGN1_SHADOWS peripheral interface</description>
      <groupName>FLASH_RGN1_SHADOWS</groupName>
      <baseAddress>0x14720000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x1024</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>FLASH_RGN1_SHADOWS</name>
        <value>6</value>
      </interrupt>
      <registers>
        <register>
          <name>PRT_LEVEL_STATUS</name>
          <displayName>PRT_LEVEL_STATUS</displayName>
          <description>protection level管理标志。</description>
          <addressOffset>0x1000</addressOffset>
          <size>32</size>
          <resetValue>0x000000FF</resetValue>
          <fields>
            <field>
              <name>reserved</name>
              <description>保留。</description>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>prt_level_status</name>
              <description>protection level管理标志。
0xFF：JTAG/SWD接口权限开放；
其他：JTAG/SWD接口权限受限，只能访问FLASH寄存器空间，读写擦eflash main rgn1，以及读info_rgn0/1区域。

当info_rgn1处于未锁定时（info_rgn1_unlock=0xFF），protection_level支持回退机制：通过向FLASH发起回退请求，依次擦除eflash main0/1_rgn和info_rgn1，PRT_LEVEL_STATUS的值将变为0xFF。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>UART_ENABLE</name>
          <displayName>UART_ENABLE</displayName>
          <description>UART使能标志。</description>
          <addressOffset>0x1010</addressOffset>
          <size>32</size>
          <resetValue>0x0000000F</resetValue>
          <fields>
            <field>
              <name>reserved</name>
              <description>保留。</description>
              <bitOffset>4</bitOffset>
              <bitWidth>28</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>uart3_enable</name>
              <description>UART3标志。
0：禁用；
1：使能。</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>uart2_enable</name>
              <description>UART2能标志。
0：禁用；
1：使能。</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>uart1_enable</name>
              <description>UART1使能标志。
0：禁用；
1：使能。</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>uart0_enable</name>
              <description>UART0能标志。
0：禁用；
1：使能。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FUNC_JTAG_ENABLE</name>
          <displayName>FUNC_JTAG_ENABLE</displayName>
          <description>FUNC JTAG使能标志。</description>
          <addressOffset>0x1014</addressOffset>
          <size>32</size>
          <resetValue>0x00000101</resetValue>
          <fields>
            <field>
              <name>reserved</name>
              <description>保留。</description>
              <bitOffset>9</bitOffset>
              <bitWidth>23</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>sysram_parity_disable</name>
              <description>SYSRAM奇偶校验使能标志。
0：使能；
1：禁用。
0：禁用；
1：使能。</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>func_jtag_enable</name>
              <description>FUNC JTAG使能标志。
0xFF：允许；
其他：禁止。
禁止：无法通过JTAG/SWD接口访问芯片；
允许：可以通过JTAG/SWD接口访问芯片。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ISP_BOOT_ENABLE</name>
          <displayName>ISP_BOOT_ENABLE</displayName>
          <description>BOOTROM串口升级使能标志寄存器。</description>
          <addressOffset>0x1018</addressOffset>
          <size>32</size>
          <resetValue>0x0000000F</resetValue>
          <fields>
            <field>
              <name>reserved</name>
              <description>保留。</description>
              <bitOffset>4</bitOffset>
              <bitWidth>28</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>can_boot_enable</name>
              <description>CAN BOOT升级使能标志。
0：禁用，bootrom无法通过CAN进行串口升级；
1：使能，bootrom可以通过CAN进行串口升级。
0：禁用；
1：使能。</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>i2c_boot_enable</name>
              <description>I2C BOOT升级使能标志。
0：禁用，bootrom无法通过I2C进行串口升级；
1：使能，bootrom可以通过I2C进行串口升级。</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>spi_boot_enable</name>
              <description>SPI BOOT升级使能标志。
0：禁用，bootrom无法通过SPI进行升级；
1：使能，bootrom可以通过SPI进行升级。</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>uart_boot_enable</name>
              <description>UART BOOT升级使能标志。
0：禁用，bootrom无法通过UART进行升级；
1：使能，bootrom可以通过UART进行升级。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MAIN_RGN0_SIZE</name>
          <displayName>MAIN_RGN0_SIZE</displayName>
          <description>main rgn0容量大小配置寄存器。</description>
          <addressOffset>0x101c</addressOffset>
          <size>32</size>
          <resetValue>0x000003FF</resetValue>
          <fields>
            <field>
              <name>reserved</name>
              <description>保留。</description>
              <bitOffset>10</bitOffset>
              <bitWidth>22</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>main_rgn0_size</name>
              <description>main rgn0容量大小配置，单位：Page（1KB/Page）。
main rgn中小于等于main_rgn0_size的Page属于main rgn0，大于main_rgn0_size的Page属于main rgn1。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>10</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>INFO_RGN1_UNLOCK</name>
          <displayName>INFO_RGN1_UNLOCK</displayName>
          <description>info_rgn1锁定标志。</description>
          <addressOffset>0x1020</addressOffset>
          <size>32</size>
          <resetValue>0x000000FF</resetValue>
          <fields>
            <field>
              <name>reserved</name>
              <description>保留。</description>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>info_rgn1_unlock</name>
              <description>info_rgn1区域锁定标志。
0xFF：未锁定；
其他：锁定。
锁定状态下，无法对info_rgn1区域进行擦除、编程操作，不支持protection level回退功能。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>GPIO0</name>
      <description>GPIO peripheral interface</description>
      <groupName>GPIO</groupName>
      <baseAddress>0x14500000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x420</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>GPIO</name>
        <value>9</value>
      </interrupt>
      <registers>
        <register>
          <dim>256</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>0-255</dimIndex>
          <name>GPIO_DATA%s</name>
          <displayName>GPIO_DATA%s</displayName>
          <description>GPIO_DATA为GPIO 数据寄存器，用来对输入或输出数据进行缓存。</description>
          <addressOffset>0</addressOffset>
          <size>0x20</size>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <name>reserved</name>
              <description>保留。</description>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>gpio_data</name>
              <description>当GPIO配置为输入模式时，为GPIO输入数据；当GPIO配置为输出模式时，为输出数据。各比特均可独立控制。与GPIO_DIR配合使用。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIO_DIR</name>
          <displayName>GPIO_DIR</displayName>
          <description>GPIO方向控制寄存器。用来配置GPIO方向。</description>
          <addressOffset>0x400</addressOffset>
          <size>8</size>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <name>gpio_dir</name>
              <description>GPIO方向控制寄存器。bit[7:0]分别对应GPIO_DATA bit[7:0]，各比特可独立控制。
0：输入；
1：输出。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIO_IS</name>
          <displayName>GPIO_IS</displayName>
          <description>GPIO中断触发寄存器。用来配置GPIO触发电平方式。</description>
          <addressOffset>0x404</addressOffset>
          <size>8</size>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <name>gpio_is</name>
              <description>GPIO中断触发控制寄存器，bit[7:0]分别对应GPIO_DATA bit[7:0]，各比特独立控制。
0：边沿触发中断；
1：电平触发中断。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIO_IBE</name>
          <displayName>GPIO_IBE</displayName>
          <description>GPIO双沿触发中断寄存器。用来配置GPIO沿触发方式。</description>
          <addressOffset>0x408</addressOffset>
          <size>8</size>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <name>gpio_ibe</name>
              <description>GPIO中断沿触发控制寄存器，bit[7:0]分别对应GPIO_DATA bit[7:0]，各比特独立控制。
0：单边沿触发中断，具体是上升沿还是下降沿触发由GPIO_IEV控制；
1：双边触发中断。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIO_IEV</name>
          <displayName>GPIO_IEV</displayName>
          <description>GPIO触发中断条件寄存器。用来配置GPIO触发中断条件。</description>
          <addressOffset>0x40c</addressOffset>
          <size>8</size>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <name>gpio_iev</name>
              <description>GPIO触发中断条件寄存器，bit[7:0]分别对应GPIO_DATA[7:0]，各比特独立控制。
0：下降沿或低电平触发中断，具体由GPIO_IS控制；
1：上升沿或高电平触发中断。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIO_IE</name>
          <displayName>GPIO_IE</displayName>
          <description>GPIO中断屏蔽寄存器。用来屏蔽GPIO中断。</description>
          <addressOffset>0x410</addressOffset>
          <size>8</size>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <name>gpio_ie</name>
              <description>GPIO中断屏蔽寄存器，bit[7:0]分别对应GPIO_DATA bit[7:0]，各比特独立控制。
0：屏蔽中断；
1：不屏蔽中断。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIO_RIS</name>
          <displayName>GPIO_RIS</displayName>
          <description>GPIO原始中断状态寄存器。用来查询GPIO原始中断状态。</description>
          <addressOffset>0x414</addressOffset>
          <size>8</size>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <name>gpio_ris</name>
              <description>GPIO原始中断寄存器，bit[7:0]分别对应GPIO_DATA bit[7:0]，指示未屏蔽的中断状态。该状态不受GPIO_IE寄存器屏蔽控制。
0：未发生中断；
1：已发生中断。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIO_MIS</name>
          <displayName>GPIO_MIS</displayName>
          <description>GPIO屏蔽状态中断寄存器。用来查询GPIO屏蔽后的中断状态。对所有位进行或操作得到中断输出gpio_int。</description>
          <addressOffset>0x418</addressOffset>
          <size>8</size>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <name>gpio_mis</name>
              <description>GPIO屏蔽后中断寄存器，bit[7:0]分别对应GPIO_DATA bit[7:0]，指示经屏蔽后的中断状态。该状态受GPIO_IE寄存器屏蔽控制。
0：中断无效；
1：中断有效。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIO_IC</name>
          <displayName>GPIO_IC</displayName>
          <description>GPIO中断清除寄存器。用来清除GPIO产生的中断，同时清除GPIO_RIS寄存器和GPIO_MIS寄存器。</description>
          <addressOffset>0x41c</addressOffset>
          <size>8</size>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <name>gpio_ic</name>
              <description>GPIO中断清除寄存器，bit[7:0]分别对应GPIO_DATA bit[7:0]，各比特可独立控制。
0：无影响；
1：清除中断。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
