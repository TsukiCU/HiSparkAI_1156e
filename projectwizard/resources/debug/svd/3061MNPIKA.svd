00:正常工作；
01:初始化；
10:睡眠；
11:下电。
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FLASH_INIT_STATUS</name>
          <displayName>FLASH_INIT_STATUS</displayName>
