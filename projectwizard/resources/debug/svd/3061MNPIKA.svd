              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>info_rgn2_illegal</name>
              <description>cmd操作info region2是否发生非法访问指示寄存器。
0:无错误；
1:info_rgn2区发生非法访问。</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>info_rgn1_illegal</name>
