              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ECC_CNT</name>
          <displayName>ECC_CNT</displayName>
          <description>ECC错误计数寄存器。</description>
          <addressOffset>0xb10</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name> dfx_flash_ecc_correct_error_cnt</name>
              <description>Main Region 或 Information Region 读数据发生 ECC 纠错失败次数，每次对应一个64bit。软件清除 int_raw_err_ecc_corr 原始中断后，重新统计。
              </description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name> dfx_flash_ecc_check_error_cnt</name>
              <description>Main Region 或 Information Region 读数据发生 ECC 检查错误次数，每次对应一个64bit。软件清除 int_raw_err_ecc_chk 原始中断后，重新统计。
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ECC_ADDR</name>
          <displayName>ECC_ADDR</displayName>
          <description>ECC错误地址寄存器。</description>
          <addressOffset>0xb14</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>dfx_flash_ecc_first_correct_error_addr</name>
              <description>读 Flash 第一次发生 ECC 检查错误的物理地址，Unit:64bit。软件清除 int_raw_err_ecc_corr 原始中断后，重新统计。最高 2 位表示区域:00:表示 Main Region；01:表示 Information Region。
              </description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>dfx_flash_ecc_first_check_error_addr</name>
              <description>读 Flash 第一次发生 ECC 检查错误的物理地址，Unit:64bit。软件清除 int_raw_err_ecc_chk 原始中断后，重新统计。最高 2 位表示区域：00：表示 Main Region；01：表示 Information Region。
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ECC_SYNDORME</name>
          <displayName>ECC_SYNDORME</displayName>
          <description>ECC错误码寄存器。</description>
          <addressOffset>0xb18</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
