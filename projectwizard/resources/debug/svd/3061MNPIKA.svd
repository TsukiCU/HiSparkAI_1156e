    <peripheral>
      <name>IWDG</name>
      <description>IWDG peripheral interface</description>
      <groupName>IWDG</groupName>
      <baseAddress>0x14401000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x20</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>IWDG</name>
        <value>8</value>
      </interrupt>
      <registers>
        <register>
          <name>IWDG_LOAD</name>
          <displayName>IWDG_LOAD</displayName>
          <description>计数初值寄存器。</description>
          <addressOffset>0x0</addressOffset>
          <size>8</size>
          <resetValue>0xFF</resetValue>
          <fields>
            <field>
              <name>iwdg_load</name>
              <description>计数初值。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>IWDG_VALUE</name>
          <displayName>IWDG_VALUE</displayName>
          <description>计数器当前值寄存器。</description>
          <addressOffset>0x4</addressOffset>
          <size>8</size>
          <resetValue>0xFF</resetValue>
          <fields>
            <field>
              <name>iwdg_value</name>
              <description>WatchDog计数器当前值，读出值延后于实际计数器的当前值约50us。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>IWDG_WINDOW</name>
          <displayName>IWDG_WINDOW</displayName>
          <description>窗口值寄存器。</description>
          <addressOffset>0x8</addressOffset>
          <size>8</size>
          <resetValue>0xFF</resetValue>
          <fields>
            <field>
              <name>iwdg_window</name>
              <description>窗口值，禁止大于计数初值寄存器，否则会产生预期之外的动作。
禁止配置窗口值小于等于4，否则喂狗指令不会及时生效，会导致IWDG复位。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>IWDG_KEY</name>
          <displayName>IWDG_KEY</displayName>
          <description>指令字寄存器。</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <resetValue>0x000000DD</resetValue>
          <fields>
            <field>
              <name>reserved</name>
              <description>保留。</description>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>iwdg_key</name>
              <description>对该寄存器写入0xAA使WatchDog从寄存器IWDG_LOAD中重新载入初值计数（喂狗），并可清除WatchDog的中断。
向该寄存器写入0x55，可打开所有可写寄存器的写权限；
向该寄存器写入其他值，关闭所有可写寄存器写权限；本寄存器始终写有效；
向该寄存器写入0xCC，可开启IWDG；
向该寄存器写入0xDD，可关闭IWDG。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>IWDG_PRE_DIV</name>
          <displayName>IWDG_PRE_DIV</displayName>
          <description>预分频寄存器。</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>reserved</name>
              <description>保留。</description>
              <bitOffset>4</bitOffset>
              <bitWidth>28</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>iwdg_pre_div</name>
              <description>工作时钟的2的幂次分频。
0x0：不分频；
0x1：2分频；
0x2：4分频：
…
0x8：256分频；
其他：保留。
最多支持256分频。
配置大于最大分频值的值，按最大分频值进行分频。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>IWDG_CONTROL</name>
          <displayName>IWDG_CONTROL</displayName>
          <description>控制寄存器。</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>reserved</name>
              <description>保留。</description>
              <bitOffset>3</bitOffset>
              <bitWidth>29</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>window_mode_en</name>
              <description>WatchDog窗口模式使能。
0：禁止；
1：使能。
当禁止窗口模式时，无需设置iwdg_window，中断固定在iwdg_load/2处产生，此时在任意时刻喂狗均不会触发复位信号，复位信号只有在计数值为0且未清除中断时才会产生。
当使能窗口模式时，iwdg_window值生效，中断在计数器值等于窗口值时产生，在窗口值之外喂狗会产生复位信号，在计数为0且未清除中断时也会产生复位信号。</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
            <field>
              <name>resen</name>
              <description>WatchDog复位信号输出使能。
0：禁止；
1：使能。</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
            <field>
              <name>reserved</name>
              <description>保留。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>MTIMER</name>
      <description>MTIMER peripheral interface</description>
      <groupName>MTIMER</groupName>
      <baseAddress>0x14380000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x1c</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>MTIMER</name>
        <value>6</value>
      </interrupt>
      <registers>
        <register>
          <name>TIMER_CTRL</name>
          <displayName>TIMER_CTRL</displayName>
          <description>Mtimer控制寄存器。</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>reserved</name>
              <description>保留。</description>
              <bitOffset>3</bitOffset>
              <bitWidth>29</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>stop_tmr_en</name>
              <description>调试模式停止计数控制。
0：调试模式下定时间继续计数；
1：调试模式下定时器停止计数。</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
            <field>
              <name>clksrc</name>
              <description>Mtimer时钟源选择。
0：使用主时钟（处理器时钟）；
1：保留。</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
            <field>
              <name>enable</name>
              <description>Mtimer使能。
0：Mtimer不使能；
1：Mtimer使能，当计数值大于等于比较值时会上报中断。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>TIMER_DIV</name>
