          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>dfx_cache_lookup_cnt</name>
              <description>Cache 查询次数统计计数器。Unit：次。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CACHE_HIT_CNT</name>
