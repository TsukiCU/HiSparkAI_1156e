        </register>
        <register>
          <name>UART_DMACR</name>
          <displayName>UART_DMACR</displayName>
          <description>DMA控制寄存器，用于配置发送通道和接收通道的DMA使能。</description>
          <addressOffset>0x48</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>reserved</name>
              <description>保留。</description>
              <bitOffset>4</bitOffset>
              <bitWidth>28</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>rxlastsreq_en</name>
              <description>UART RX DMA支持最后一笔数据的REQ使能。使能打开后，传输最后一笔数据时会发出LASTREQ给DMA控制器。可以自动对DMA进行硬件流控。
0：禁止；
1：使能。</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
            <field>
              <name>dmaonerr</name>
              <description>UART错误中断（UARTEINTR）出现时的接收通道DMA使能控制。
0：当UART错误中断（UARTEINTR）有效时，接收通道DMA的请求输出（UARTRXDMASREQ或UARRTXDMABREQ）有效；
1：当UART错误中断（UARTEINTR）有效时，接收通道DMA的请求输出（UARTRXDMASREQ或UARRTXDMABREQ）无效。</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
            <field>
              <name>txdmae</name>
              <description>发送通道的DMA使能控制。
0：禁止；
1：使能。</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
            <field>
              <name>rxdmae</name>
              <description>接收通道的DMA使能控制。
0：禁止；
1：使能。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>UART_DS</name>
          <displayName>UART_DS</displayName>
          <description>数据位序配置寄存器，用于配置数据位序。</description>
          <addressOffset>0x50</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>reserved</name>
              <description>保留。</description>
              <bitOffset>1</bitOffset>
              <bitWidth>31</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>msbfirst</name>
              <description>最高有效位在前使能。
0：在起始位之后，首先使用数据位的LSB发送/接收数据；
1：在起始位之后，首先使用数据位的MSB发送/接收数据。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>UART_RTCFG</name>
          <displayName>UART_RTCFG</displayName>
          <description>接收超时时长配置寄存器，用于配置判断接收超时的条件。</description>
          <addressOffset>0x54</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>reserved</name>
              <description>保留。</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>spcfg</name>
              <description>配置接收超时时长，单位是 bit 时长。
接收超时时长=配置值+1。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>UART_SPCFG</name>
          <displayName>UART_SPCFG</displayName>
          <description>过采样配置寄存器，用于配置过采样倍数。</description>
          <addressOffset>0x58</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>reserved</name>
              <description>保留。</description>
              <bitOffset>4</bitOffset>
              <bitWidth>28</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>spcfg</name>
              <description>配置过采样倍数。
0x0：16倍过采样；
0x1：15倍过采样；
0x2：14倍过采样；
0x3：13倍过采样；
0x4：12倍过采样；
其它：禁止配置。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>UART_ABDEN</name>
          <displayName>UART_ABDEN</displayName>
          <description>自动波特率检测使能寄存器，用于配置自动波特率检测使能。</description>
          <addressOffset>0x5c</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>reserved</name>
              <description>保留。</description>
              <bitOffset>6</bitOffset>
              <bitWidth>26</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>abdenvld</name>
              <description>abden已经有效的标志。
0：abden还未生效；
1：abden已经生效，UART可以接收大写字符Z进行自动波特率检测。</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>abdbusy</name>
              <description>自动波特率检测忙标志。
0：不在进行自动波特率检测；
1：正在进行自动波特率检测。</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>reserved</name>
              <description>保留。</description>
              <bitOffset>1</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>abden</name>
              <description>自动波特率检测使能。
0：禁止自动波特率检测；
1：使能自动波特率检测。
如果UART_CR[uarten]使能，且使能UART_CR[rxe]或UART_CR[txe]，则abden会被自动清零。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>UART_CHARMATCH</name>
          <displayName>UART_CHARMATCH</displayName>
          <description>字符匹配配置寄存器，用于配置需要匹配的字符。</description>
          <addressOffset>0x60</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>charmaten</name>
              <description>字符匹配检测使能。
0：禁止字符匹配检测；
1：使能字符匹配检测。</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
            <field>
              <name>reserved</name>
              <description>保留。</description>
              <bitOffset>8</bitOffset>
              <bitWidth>23</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>charmat</name>
              <description>需要匹配的字符二进制。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
