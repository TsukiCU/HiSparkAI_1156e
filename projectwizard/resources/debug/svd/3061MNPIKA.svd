              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CRC_PRE_CFG</name>
          <displayName>CRC_PRE_CFG</displayName>
          <description>CRC前级处理，配置寄存器。</description>
