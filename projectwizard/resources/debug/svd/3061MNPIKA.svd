    <peripheral>
      <name>WWDG</name>
      <description>WWDG peripheral interface</description>
      <groupName>WWDG</groupName>
      <baseAddress>0x14400000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x20</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>WWDG</name>
        <value>8</value>
      </interrupt>
      <registers>
        <register>
          <name>WWDG_LOAD</name>
          <displayName>WWDG_LOAD</displayName>
          <description>计数初值寄存器。</description>
          <addressOffset>0x0</addressOffset>
          <size>16</size>
          <resetValue>0xFFFF</resetValue>
          <fields>
            <field>
              <name>wwdg_load</name>
              <description>计数初值。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>WWDG_VALUE</name>
          <displayName>WWDG_VALUE</displayName>
          <description>计数器当前值寄存器。</description>
          <addressOffset>0x4</addressOffset>
          <size>16</size>
          <resetValue>0xFFFF</resetValue>
          <fields>
            <field>
              <name>wwdg_value</name>
              <description>WatchDog计数器当前值。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WWDG_WINDOW</name>
          <displayName>WWDG_WINDOW</displayName>
          <description>窗口值寄存器。</description>
          <addressOffset>0x8</addressOffset>
          <size>16</size>
          <resetValue>0xFFFF</resetValue>
          <fields>
            <field>
              <name>wwdg_window</name>
              <description>窗口值，禁止大于计数初值寄存器，否则会产生预期之外的动作。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>WWDG_KEY</name>
          <displayName>WWDG_KEY</displayName>
          <description>指令字寄存器。</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <resetValue>0x000000DD</resetValue>
          <fields>
            <field>
              <name>reserved</name>
              <description>保留。</description>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>wwdg_key</name>
              <description>对该寄存器写入0xAA使WatchDog从寄存器WWDG_LOAD中重新载入初值计数（喂狗），并可清除WatchDog的中断。
向该寄存器写入0x55，可打开所有可写寄存器的写权限；
向该寄存器写入其他值，关闭所有可写寄存器写权限；本寄存器始终写有效；
向该寄存器写入0xCC，可开启WWDG；
向该寄存器写入0xDD，可关闭WWDG。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>WWDG_PRE_DIV</name>
          <displayName>WWDG_PRE_DIV</displayName>
          <description>预分频寄存器。</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>reserved</name>
              <description>保留。</description>
              <bitOffset>4</bitOffset>
              <bitWidth>28</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>wwdg_pre_div</name>
              <description>工作时钟的2的幂次分频。
0x0：不分频；
0x1：2分频；
0x2：4分频：
……
0xD：8192分频；
其他：保留。
最多支持8192分频。
配置大于最大分频值的值，按最大分频值进行分频。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>WWDG_CONTROL</name>
          <displayName>WWDG_CONTROL</displayName>
          <description>控制寄存器。</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>reserved</name>
              <description>保留。</description>
              <bitOffset>3</bitOffset>
              <bitWidth>29</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>window_mode_en</name>
              <description>WatchDog窗口模式使能。
0：禁止；
1：使能。
当禁止窗口模式时，无需设置wwdg_window，中断固定在wwdg_load/2处产生，此时在任意时刻喂狗均不会触发复位信号，复位信号只有在计数值为0且未清除中断时才会产生。
当使能窗口模式时，wwdg_window值生效，中断在计数器值等于窗口值时产生，在窗口值之外喂狗会产生复位信号，在计数为0且未清除中断时也会产生复位信号。</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
            <field>
              <name>resen</name>
              <description>WatchDog复位信号输出使能。
0：禁止；
1：使能。</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
            <field>
              <name>inten</name>
              <description>WatchDog中断信号输出使能。
0：禁止wwdgmis产生；
1：使能wwdgmis。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>WWDG_RIS</name>
          <displayName>WWDG_RIS</displayName>
          <description>原始中断标志寄存器。</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>reserved</name>
              <description>保留。</description>
              <bitOffset>1</bitOffset>
              <bitWidth>31</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>wwdgris</name>
              <description>WatchDog原始中断状态。
0：未产生中断；
1：已产生中断。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WWDG_MIS</name>
          <displayName>WWDG_MIS</displayName>
          <description>屏蔽后中断标志寄存器。</description>
          <addressOffset>0x1c</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>reserved</name>
              <description>保留。</description>
              <bitOffset>1</bitOffset>
              <bitWidth>31</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>wwdgmis</name>
              <description>WatchDog屏蔽后的中断状态。
0：未产生中断或者中断被屏蔽；
1：已产生中断。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
  </peripherals>
</device>
