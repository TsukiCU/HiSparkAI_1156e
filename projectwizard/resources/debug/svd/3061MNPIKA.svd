001：保留；
010：CRC-16，多项式0x8005；
011：CRC-16，多项式0x1021；
100：CRC-32，多项式0x04c11db7；
其他：保留。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
