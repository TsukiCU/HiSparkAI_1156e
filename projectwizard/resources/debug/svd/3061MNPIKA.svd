              <description>报文对象的方向。
0：报文对象为接收方向，接收报文；
1：报文对象为发送方向，发送报文。</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
            <field>
              <name>if2_arbitration2_id</name>
