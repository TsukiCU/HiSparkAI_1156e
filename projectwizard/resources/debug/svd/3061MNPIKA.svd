          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>die_id_1</name>
              <description>芯片出厂DIE_ID_1，每颗芯片具有特异值。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DIE_ID_2</name>
          <displayName>DIE_ID_2</displayName>
          <description>芯片出厂DIE_ID_2，DIE_ID寄存器。</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>die_id_2</name>
              <description>芯片出厂DIE_ID_2，每颗芯片具有特异值。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DIE_ID_3</name>
          <displayName>DIE_ID_3</displayName>
