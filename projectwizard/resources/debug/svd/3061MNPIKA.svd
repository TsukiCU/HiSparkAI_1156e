0x0：0个I2C工作时钟周期；
0x1：1个I2C工作时钟周期；
…
0x7FFFFF：8388607个I2C工作时钟周期。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>23</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>modify</modifiedWriteValues>
            </field>
          </fields>
        </register>
