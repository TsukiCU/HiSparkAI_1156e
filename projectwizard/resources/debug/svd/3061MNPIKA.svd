              <bitOffset>2</bitOffset>
              <bitWidth>30</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>dmaovmis</name>
              <description>屏蔽后的DMA请求溢出中断状态。
0：中断无效；
1：中断有效。</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>timermis</name>
              <description>屏蔽后的定时中断状态。
0：中断无效；
1：中断有效。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TIMERx_BGLOAD</name>
          <displayName>TIMERx_BGLOAD</displayName>
