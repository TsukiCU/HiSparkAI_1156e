              </description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>reserved</name>
              <description>保留。</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>dfx_flash_ecc_first_check_error_syndrome</name>
              <description>读 Flash 第一次发生 ECC 检查错误的错误字符。软件清除 int_raw_err_ecc_chk 原始中断后，重新统计。
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CACHE_HIT_CLR</name>
          <displayName>CACHE_HIT_CLR</displayName>
          <description>Cache命中率清除寄存器。</description>
          <addressOffset>0xb24</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>reserved</name>
              <description>保留。</description>
              <bitOffset>1</bitOffset>
              <bitWidth>31</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>dfx_cache_hit_clr</name>
              <description>dfx_cache_lookup_cnt 与dfx_cache_hit_cnt 计数器清零控制寄存器。写 0 无效果；写 1 dfx_cache_lookup_cnt 与dfx_cache_hit_cnt 清零。
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
